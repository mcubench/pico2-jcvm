#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_file="${repo_root}/choupi/javacard-sdk/javacard-api/src/javacardx/apdu/util/APDUUtil.java"
build_dir="$(mktemp -d)"
trap 'rm -rf "${build_dir}"' EXIT

javac -d "${build_dir}" \
  "${source_file}" \
  "${repo_root}/tools/tests/apdu_util/APDUUtilTest.java"
java -cp "${build_dir}" APDUUtilTest
