#!/usr/bin/env bash
# Assemble the external Windows test package for the current normal max_crypto
# ARM build: empty-card UF2, pinned user-supplied JCAlgTest 1.8.5/jc305 CAP, supplied 1.8.5
# client, GPPro, capture script, README, provenance and checksums.
#
# Usage: ./tools/package-maxcrypto-windows-test
# Preconditions: ./tools/build arm --profile max_crypto was run from the
# current HEAD (the CPLC personalizer id must match HEAD); no hardware needed.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

require_command zip
require_command python3
[[ $# -eq 0 ]] || die "usage: ./tools/package-maxcrypto-windows-test"

build_dir="${repo_root}/build/arm"
firmware="${build_dir}/pico2_choupi.uf2"
provenance="${build_dir}/build-provenance.txt"
elf="${build_dir}/pico2_choupi.elf"
[[ -s "${firmware}" && -s "${provenance}" && -s "${elf}" ]] || \
  die "run ./tools/build arm --profile max_crypto first"

head_full="$(git -C "${repo_root}" rev-parse HEAD)"
head_short="${head_full:0:8}"
cplc_id="$(awk -F= '$1=="cplc_source_id"{print $2}' "${provenance}")"
expected_prefix="$(printf '0x%s' "$(printf '%s' "${head_full:0:8}" | tr 'a-f' 'A-F')")"
[[ "${cplc_id}" == "${expected_prefix}"* ]] || \
  die "build CPLC id ${cplc_id} does not match HEAD ${head_short}; rebuild from HEAD"
grep -qx 'profile=max_crypto' "${provenance}" || die "build is not the max_crypto profile"
grep -qx 'mode=normal' "${provenance}" || die "build is not in normal mode"
grep -qx 'object_deletion=ON' "${provenance}" || die "object deletion is not ON"
for flag in debug_heap_gc debug_ccid_applet debug_persistent_gc debug_fail_reclaim_alloc; do
  grep -qx "${flag}=OFF" "${provenance}" || die "${flag} is not OFF"
done

name="pico2-jcvm-maxcrypto-${head_short}_$(date +%Y%m%d)"
stage_root="${repo_root}/build/external-test"
stage="${stage_root}/${name}"
zip_path="${stage_root}/${name}.zip"
uf2_name="${name}-empty-card.uf2"
uf2_artifact="${repo_root}/artifacts/firmware/${uf2_name}"

cap="$("${repo_root}/tools/fixture-path" jcalgtest.cap)"
# User directive 2026-11-21: new runs use the 1.8.5-20261121 client (fewer
# internal repetitions for asymmetric algorithms). It is staged under the
# file name the run template expects.
client="$("${repo_root}/tools/fixture-path" jcalgtest.client.1.8.5-20261121)"
client_lib="$(dirname "${client}")/lib"
# User directive 2026-11-25: the 1.8.6/jc32 PQC pair runs beside, never instead of, 1.8.5/jc305.
cap_jc32="$("${repo_root}/tools/fixture-path" jcalgtest.cap.1.8.6-jc32)"
client_jc32="$("${repo_root}/tools/fixture-path" jcalgtest.client.1.8.6)"
gp_jar="${repo_root}/.local-toolchain/globalplatformpro/tool/target/gp.jar"
capture_ps1="${repo_root}/tools/capture-object-deletion.ps1"
run_template="${repo_root}/tools/templates/maxcrypto-windows-run.ps1.in"
run_all_template="${repo_root}/tools/templates/windows-run-all.ps1.in"
health_ps1="${repo_root}/tools/windows-health.ps1"
reconnect_ps1="${repo_root}/tools/measure-windows-reconnect.ps1"
# User-supplied JCMathLib unit-test CAP (bytes unchanged), pinned by hash.
jcmathlib_cap="${repo_root}/inbox/problem_jcmathlib/unit_tests.cap"
jcmathlib_cap_sha=9ad6debfcf7afb5c6cafc4d1ac598ce6c6e4397fe3cb415941ee18184c5ded3a
for f in "${cap}" "${client}" "${cap_jc32}" "${client_jc32}" "${gp_jar}" "${capture_ps1}" "${run_template}" "${run_all_template}" "${health_ps1}" "${reconnect_ps1}" "${jcmathlib_cap}"; do
  [[ -s "${f}" ]] || die "missing input: ${f}"
done
[[ -d "${client_lib}" ]] || die "missing client lib directory: ${client_lib}"
[[ "$(sha256sum "${jcmathlib_cap}" | cut -d' ' -f1)" == "${jcmathlib_cap_sha}" ]] || \
  die "JCMathLib CAP hash mismatch: ${jcmathlib_cap}"

"${repo_root}/tools/fixture-path" --verify >/dev/null
"${repo_root}/tools/package-empty-card-uf2" "${firmware}" "${uf2_artifact}" >/dev/null

rm -rf -- "${stage}" "${zip_path}"
mkdir -p "${stage}/firmware" "${stage}/tools/lib"
cp "${uf2_artifact}" "${stage}/firmware/${uf2_name}"
cp "${cap}" "${stage}/applet.cap"
cp "${client}" "${stage}/tools/AlgTestJClient_v1.8.5.jar"
cp "${cap_jc32}" "${stage}/applet-jc32.cap"
cp "${client_jc32}" "${stage}/tools/AlgTestJClient_v1.8.6_jc32.jar"
cp "${gp_jar}" "${stage}/tools/gp.jar"
cp "${capture_ps1}" "${stage}/tools/capture-object-deletion.ps1"
cp -L "${client_lib}"/*.jar "${stage}/tools/lib/"
cp "${health_ps1}" "${stage}/tools/health.ps1"
cp "${reconnect_ps1}" "${stage}/tools/measure-windows-reconnect.ps1"
cp "${jcmathlib_cap}" "${stage}/jcmathlib-unit_tests.cap"
# Precompiled so the Windows side needs only a JRE.
mkdir -p "${stage}/tools/loader"
"${repo_root}/tools/env" javac --release 8 -cp "${gp_jar}" -d "${stage}/tools/loader" \
  "${repo_root}/tools/LoadCapWithDescriptor.java"

sha() { sha256sum "$1" | cut -d' ' -f1; }
uf2_sha="$(sha "${stage}/firmware/${uf2_name}")"
uf2_size="$(stat -c %s "${stage}/firmware/${uf2_name}")"
cap_sha="$(sha "${stage}/applet.cap")"
client_sha="$(sha "${stage}/tools/AlgTestJClient_v1.8.5.jar")"
cap_jc32_sha="$(sha "${stage}/applet-jc32.cap")"
client_jc32_sha="$(sha "${stage}/tools/AlgTestJClient_v1.8.6_jc32.jar")"
gp_sha="$(sha "${stage}/tools/gp.jar")"
fw_build_sha="$(sha "${firmware}")"
nm_tool="$(command -v arm-none-eabi-nm)"
linked_end="$("${nm_tool}" "${elf}" | awk '$3=="__flash_binary_end"{print $1}')"
[[ -n "${linked_end}" ]] || die "cannot read __flash_binary_end from ${elf}"
linked_end_dec=$((16#${linked_end}))
remaining=$((0x10100000 - linked_end_dec))
printf -v linked_end_hex '0x%08x' "${linked_end_dec}"
compiler="$(arm-none-eabi-gcc --version | head -1)"
worktree_diff_sha="$(git -C "${repo_root}" diff --ignore-submodules=all HEAD | sha256sum | cut -d' ' -f1)"
worktree_files="$(git -C "${repo_root}" status --porcelain --ignore-submodules=all | awk '{print $2}' | paste -sd, -)"

{
  cat "${provenance}"
  printf 'source_head=%s\n' "${head_full}"
  printf 'tracked_worktree_diff_sha256=%s\n' "${worktree_diff_sha}"
  printf 'tracked_worktree_changes_outside_submodules=%s\n' "${worktree_files:-none}"
  printf 'submodule_status:\n'
  git -C "${repo_root}" submodule status
  printf '\nfirmware_build_uf2_sha256=%s\n' "${fw_build_sha}"
  printf 'firmware_linked_end=%s\n' "${linked_end_hex}"
  printf 'firmware_window_remaining_bytes=%s\n' "${remaining}"
  printf 'persistent_overlay=96_KiB_8192_slots\n'
  printf 'empty_card_storage_range=0x10100000-0x101FFFFF\n'
  printf 'empty_card_uf2_sha256=%s\n' "${uf2_sha}"
  printf 'compiler=%s\n' "${compiler}"
  printf 'telemetry=OBJECT_DELETION:PRE_CLEANUP (serial), 90%% arena gate checked by tools/check-object-deletion-headroom.py\n'
  printf 'jcalgtest_cap=1.8.5_jc305_unchanged\n'
  printf 'jcalgtest_cap_sha256=%s\n' "${cap_sha}"
  printf 'jcalgtest_client=1.8.5-20261121\n'
  printf 'jcalgtest_client_sha256=%s\n' "${client_sha}"
  printf 'jcalgtest_pqc_cap=1.8.6_jc32\n'
  printf 'jcalgtest_pqc_cap_sha256=%s\n' "${cap_jc32_sha}"
  printf 'jcalgtest_pqc_client_sha256=%s\n' "${client_jc32_sha}"
  printf 'gppro_sha256=%s\n' "${gp_sha}"
  printf 'local_validation=recorded_after_packaging_in_.agent/EXT_REQUESTS.md_and_progress.md_for_this_commit (not asserted at package time)\n'
  printf 'windows_test=not_performed\n'
} > "${stage}/BUILD-PROVENANCE.txt"

run_block="$(sed -e "s|@UF2_NAME@|${uf2_name}|g" -e "s|@UF2_SHA@|${uf2_sha}|g" -e "s|@HEAD_SHORT@|${head_short}|g" "${run_template}")"
printf '%s\n' "${run_block}" > "${stage}/run-test.ps1"
sed -e "s|@UF2_SHA@|${uf2_sha}|g" -e "s|@HEAD_SHORT@|${head_short}|g" "${run_all_template}" > "${stage}/run-all.ps1"

cat > "${stage}/README.md" <<EOF
# Pico 2 JCVM max_crypto — object deletion ON, empty card

RP2350 ARM normal-mode firmware built from commit \`${head_full}\`. Object deletion is ON, debug/trace flags are OFF, startup wait is 0 ms, and the empty-card image contains a fully erased 1 MiB persistent-storage region. No applet is preinstalled. It was built with ${compiler}. Changes since earlier packages are listed in the repository's \`progress.md\` and \`.agent/EXT_REQUESTS.md\` for this commit.

This package is prepared for external Windows testing. Validation of this exact UF2 in the Linux development environment, if any, is recorded in \`.agent/EXT_REQUESTS.md\`; nothing in this package was tested on Windows. Treat results as candidate evidence until they are reviewed.

## Exact inputs

- Firmware: \`firmware/${uf2_name}\`
- UF2 SHA-256: \`${uf2_sha}\`
- UF2 size: ${uf2_size} bytes (firmware plus erased persistent storage)
- Profile: \`max_crypto\`; build mode: \`normal\`; object deletion: ON; debug/trace: OFF
- CPLC source identifier: \`${cplc_id}\`
- Linked firmware end: \`${linked_end_hex}\`; remaining firmware window: ${remaining} bytes
- CAP: unchanged user-supplied JCAlgTest 1.8.5 / jc305 (\`applet.cap\`), SHA-256 \`${cap_sha}\`
- Host client: supplied JCAlgTest 1.8.5-20261121 build (\`tools/AlgTestJClient_v1.8.5.jar\`, fewer internal repetitions for asymmetric algorithms), SHA-256 \`${client_sha}\`
- PQC CAP (modes \`pqc\` and \`pqcperf\`): JCAlgTest 1.8.6 / jc32 (\`applet-jc32.cap\`, CAP 2.3, built from the user's AlgTest sources with Java Card 3.2 ML-KEM/ML-DSA support and performance tests), SHA-256 \`${cap_jc32_sha}\`
- PQC client (modes \`pqc\` and \`pqcperf\`): \`tools/AlgTestJClient_v1.8.6_jc32.jar\`, SHA-256 \`${client_jc32_sha}\`
- GPPro: \`tools/gp.jar\`

## Recommended: one campaign script (closes all open Windows checks)

Requirements: Java 8 or newer on \`PATH\`, and only this Pico 2 attached as a smart-card reader.

\`\`\`powershell
powershell -ExecutionPolicy Bypass -File run-all.ps1
\`\`\`

It runs \`pqc\`, \`pqcperf\`, \`jcmathlib\`, three cold-reconnect timings, \`symmetric\` and \`all\` in that order. Before each card mode it asks you to reconnect the Pico 2 with BOOTSEL held, and it reflashes the empty card. After \`all\` it times GPPro DELETE and lists the registry. The steps that need you come first, so \`all\` (5–8 hours) can run unattended. To resume or run a subset, use for example \`-Modes symmetric,all\`. Return the single \`results\\campaign_<timestamp>.zip\`.

Every run records the card's health record (\`health-before.txt\`, \`health-after.txt\`) through GET DATA \`DF7E\`: boot count, reset cause, APDU count and \`6F00\` count since power-on. These show silent card resets even when the serial capture is missing. \`health_boot_count\` must stay 1 for the whole run.

If you run the JCAlgTest client yourself instead, read the record right after the run, without unplugging the card, and return its output with the client log:

\`\`\`powershell
powershell -ExecutionPolicy Bypass -File tools\\health.ps1 -Reader 'Pico2 JCVM CCID 0'
\`\`\`

## Run a single mode from Windows (one block)

Requirements: Java 8 or newer on \`PATH\`, Windows PowerShell 5.1 or PowerShell 7, and only this Pico 2 attached as a smart-card reader. If any other reader is present, the client asks for a reader number.

1. Extract this ZIP and open PowerShell in the extracted directory.
2. Hold BOOTSEL while you connect the Pico 2, so that the \`rp2350\` drive appears.
3. Set \`\$mode\` in the first lines, then paste the whole block. The same code is in \`run-test.ps1\`.

| \`\$mode\` | JCAlgTest menu equivalent | Duration | How the client is driven |
|---|---|---|---|
| \`all\` | \`2 -> PERFORMANCE TEST\` -> \`1 -> All algorithms\` | 5–8 hours | command line: \`-op ALG_PERFORMANCE_STATIC -cardname <name> -fresh -outpath <dir>\` |
| \`pqc\` | support test (\`ALG_SUPPORT_BASIC\`) with the 1.8.6/jc32 CAP and client | minutes | command line: \`-op ALG_SUPPORT_BASIC -cardname <name> -fresh -outpath <dir>\`; expected: all 19 rows in the \`PQCKeyFactory\`, \`KEM ALG_ML_KEM\` and \`Signature ML-DSA\` sections report \`yes\` |
| \`pqcperf\` | \`2 -> PERFORMANCE TEST\` -> \`4 -> Only post-quantum algorithms\` with the 1.8.6/jc32 CAP and client | 5–10 minutes | like \`symmetric\`, but the block types \`2\`, \`4\`; expected: 33 measurements (ML-KEM-512/768/1024 keygen, encapsulate, decapsulate; ML-DSA-44/65/87 keygen, sign, verify, init), no error rows. One slow ML-DSA-65/87 \`expandSeed()\` measurement is a flash journal rollover and is expected |
| \`jcmathlib\` | none: loads \`jcmathlib-unit_tests.cap\` with the descriptor-preserving loader and replays the BnShiftRight APDU | seconds | expected: \`JCMATHLIB result=PASS\` |
| \`symmetric\` | \`2 -> PERFORMANCE TEST\` -> \`2 -> Only algorithms WITHOUT asymmetric cryptography\` | 1–3 hours | the 1.8.5 client has no switch for this; the block starts it with \`-cardname\` and \`-outpath\` and types \`2\`, \`2\` after each prompt appears in the client log |

The block does the following:
- Verifies the firmware hash and flashes the empty-card image.
- Waits for the reader, then finds the chip ID and serial COM port.
- Starts the serial capture and installs \`applet.cap\` with GPPro.
- Runs the client and stops the capture when the client exits.
- Writes \`run-identity.txt\` and packs everything into \`results\\<mode>_<timestamp>.zip\`.

Run each mode on a freshly flashed card. The block reflashes the empty image each time.

\`\`\`powershell
${run_block}
\`\`\`

Return each \`results\\<mode>_<timestamp>.zip\` (client CSV/log, \`serial.log\`, GPPro output, \`run-identity.txt\`), and report any USB/PC/SC disconnects, resets, stalls, exceptions or timeouts. Keep each physical device's results separate.

The default GPPro test key (\`40 41 … 4F\`) is public and for educational testing only.
EOF

(
  cd "${stage}"
  find . -type f ! -name SHA256SUMS.txt | sort | sed 's|^\./||' | \
    while read -r f; do printf '%s  %s\n' "$(sha256sum "$f" | cut -d' ' -f1)" "$f"; done
) > "${stage}/SHA256SUMS.txt"

( cd "${stage_root}" && zip -qr "${zip_path}" "${name}" )
zip_sha="$(sha "${zip_path}")"
printf 'PACKAGE:PASS zip=%s\n' "${zip_path}"
printf 'PACKAGE:ZIP_SHA256 %s\n' "${zip_sha}"
printf 'PACKAGE:UF2 %s sha256=%s size=%s\n' "${uf2_artifact}" "${uf2_sha}" "${uf2_size}"
printf 'PACKAGE:FIRMWARE end=%s remaining=%s cplc=%s head=%s\n' \
  "${linked_end_hex}" "${remaining}" "${cplc_id}" "${head_short}"
