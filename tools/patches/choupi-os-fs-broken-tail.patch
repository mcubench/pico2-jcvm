                         get!(erase_invalid_data(flash, sector, next_block[id]));
+                        // The recovery routine programs every non-erased byte
+                        // in the damaged tail to zero. Flash cannot later
+                        // change those zero bits back to one, so this region
+                        // is not appendable even though it was excluded from
+                        // valid_size. Keep the sector full until defrag copies
+                        // its surviving live files into an erased sector.
+                        next_block[id] = sector.len();
                         continue 'nextsector;
                     }
                     Err(ParseNoBlock::Erased(size)) => {
