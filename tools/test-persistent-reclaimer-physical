#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

require_host_usb_access
[[ $# -ge 1 && $# -le 3 ]] || die "usage: PICO2_HOST_USB_ACCESS=1 ./tools/test-persistent-reclaimer-physical 'exact reader name' [RSA cycles 1..16] [RSA bits 512|1024|2048|4096]"
reader_name="$1"
rsa_cycles="${2:-8}"
rsa_bits="${3:-4096}"
[[ "${rsa_cycles}" =~ ^([1-9]|1[0-6])$ ]] || \
  die "RSA cycles must be an integer in 1..16"
[[ "${rsa_bits}" == 512 || "${rsa_bits}" == 1024 || \
   "${rsa_bits}" == 2048 || "${rsa_bits}" == 4096 ]] || \
  die "RSA bits must be 512, 1024, 2048, or 4096"
monitor_seconds=$((120 + rsa_cycles * 15))
probe_timeout=$((100 + rsa_cycles * 15))
[[ "${reader_name}" =~ \(([[:xdigit:]]{16})\) ]] || \
  die "reader name must contain a 16-digit Pico chip ID"
chip_id="${BASH_REMATCH[1]}"
gp_jar="${repo_root}/.local-toolchain/globalplatformpro/tool/target/gp.jar"
cap="${repo_root}/build/persistent-reclaimer-probe/output/PersistentReclaimerProbe.cap"
package_aid="A0000000620302"
applet_aid="A000000062030201"
host_build="${repo_root}/build/persistent-reclaimer-probe/host"
[[ -s "${gp_jar}" ]] || die "GlobalPlatformPro jar not found: ${gp_jar}"

"${repo_root}/tools/build-persistent-reclaimer-probe"
mkdir -p "${host_build}" "${repo_root}/artifacts/logs"
"${repo_root}/tools/env" javac -d "${host_build}" \
  "${repo_root}/tests/hardware/PersistentReclaimerPhysicalProbe.java"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log="${repo_root}/artifacts/logs/persistent-reclaimer-physical-${timestamp}.log"
serial_log="${repo_root}/artifacts/logs/persistent-reclaimer-serial-${chip_id}-${timestamp}.log"
list_log="${repo_root}/build/persistent-reclaimer-probe/gp-list-${timestamp}.log"
install_log="${repo_root}/build/persistent-reclaimer-probe/gp-install-${timestamp}.log"
delete_applet_log="${repo_root}/build/persistent-reclaimer-probe/gp-delete-applet-${timestamp}.log"
delete_package_log="${repo_root}/build/persistent-reclaimer-probe/gp-delete-package-${timestamp}.log"
gp=("${repo_root}/tools/env" java -jar "${gp_jar}" "--reader=${reader_name}")
installed=0
monitor_pid=""

cleanup() {
  local status=$?
  trap - EXIT
  if [[ "${installed}" == 1 ]]; then
    local cleanup_status=0
    if timeout --signal=TERM --kill-after=5s 30s "${gp[@]}" --list \
        >"${list_log}" 2>&1; then
      if grep -Fq "APP: ${applet_aid} " "${list_log}"; then
        timeout --signal=TERM --kill-after=5s 60s "${gp[@]}" \
          --delete "${applet_aid}" >"${delete_applet_log}" 2>&1 || cleanup_status=1
      fi
      if (( cleanup_status == 0 )) && grep -Fq "PKG: ${package_aid} " "${list_log}"; then
        timeout --signal=TERM --kill-after=5s 60s "${gp[@]}" \
          --delete "${package_aid}" >"${delete_package_log}" 2>&1 || cleanup_status=1
      fi
      if (( cleanup_status == 0 )) && timeout --signal=TERM --kill-after=5s 30s \
          "${gp[@]}" --list >"${list_log}" 2>&1; then
        if grep -Fq "APP: ${applet_aid} " "${list_log}" || \
           grep -Fq "PKG: ${package_aid} " "${list_log}"; then
          cleanup_status=1
        fi
      else
        cleanup_status=1
      fi
    else
      cleanup_status=1
    fi
    if (( cleanup_status == 0 )); then
      printf 'PERSISTENT_RECLAIMER:CLEANUP_PASS package=%s\n' \
        "${package_aid}" | tee -a "${log}"
    else
      printf 'PERSISTENT_RECLAIMER:CLEANUP_FAIL package=%s log=%s\n' \
        "${package_aid}" "${list_log}" | tee -a "${log}"
      status=1
    fi
  fi
  if [[ -n "${monitor_pid}" ]]; then
    local monitor_status=0
    if (( status != 0 )); then
      kill -TERM "${monitor_pid}" 2>/dev/null || true
    fi
    wait "${monitor_pid}" || monitor_status=$?
    monitor_pid=""
    if (( monitor_status != 0 )); then
      printf 'PERSISTENT_RECLAIMER:SERIAL_CAPTURE_FAIL status=%s log=%s\n' \
        "${monitor_status}" "${serial_log}" | tee -a "${log}"
      status=1
    fi
  fi
  exit "${status}"
}
trap cleanup EXIT

exec > >(tee -a "${log}") 2>&1
printf 'PERSISTENT_RECLAIMER:START reader=%s rsa_cycles=%s rsa_bits=%s\n' \
  "${reader_name}" "${rsa_cycles}" "${rsa_bits}"
PICO2_HOST_USB_ACCESS=1 sudo -n /usr/local/sbin/pico2-pcsc-reader
timeout --signal=TERM --kill-after=5s 30s "${gp[@]}" --list \
  >"${list_log}" 2>&1 || die "GPPro list failed; see ${list_log}"
if grep -Fq "APP: ${applet_aid} " "${list_log}" || \
   grep -Fq "PKG: ${package_aid} " "${list_log}"; then
  die "persistent-reclaimer test AID already exists; refusing to replace it"
fi

installed=1
timeout --signal=TERM --kill-after=5s 90s "${gp[@]}" --install "${cap}" \
  >"${install_log}" 2>&1 || die "probe install failed; see ${install_log}"
cat "${install_log}"
PICO2_HOST_USB_ACCESS=1 "${repo_root}/tools/monitor" \
  --serial "${chip_id}" --seconds "${monitor_seconds}" >"${serial_log}" 2>&1 &
monitor_pid=$!
monitor_ready=0
for _ in $(seq 1 140); do
  if grep -Fq 'MONITOR:START ' "${serial_log}"; then
    monitor_ready=1
    break
  fi
  if ! kill -0 "${monitor_pid}" 2>/dev/null; then
    break
  fi
  sleep 0.25
done
(( monitor_ready == 1 )) || die "serial monitor did not attach; see ${serial_log}"
PICO2_HOST_USB_ACCESS=1 timeout --signal=TERM --kill-after=5s \
  "${probe_timeout}s" "${repo_root}/tools/env" java -cp "${host_build}" \
  PersistentReclaimerPhysicalProbe "${reader_name}" "${rsa_cycles}" "${rsa_bits}"
monitor_status=0
wait "${monitor_pid}" || monitor_status=$?
monitor_pid=""
(( monitor_status == 0 )) || die "serial capture failed; see ${serial_log}"
if grep -Eq '(^|[[:space:]])FAULT|TEST:FAIL' "${serial_log}"; then
  die "serial capture contains a runtime failure; see ${serial_log}"
fi
if ! grep -Eq \
    'CHOUPI:PERSISTENT_GC .*result=0 erased=[1-9][0-9]* .*candidates=[1-9][0-9]*' \
    "${serial_log}"; then
  die "no completed persistent-tag erase was reported; ensure the board runs a PERSISTENT_GC-hook image; see ${serial_log}"
fi
positive_reclaims="$(grep -Ec \
  '^CHOUPI:PERSISTENT_GC .*result=0 erased=[1-9][0-9]* ' \
  "${serial_log}" || true)"
(( positive_reclaims >= rsa_cycles )) || \
  die "expected at least ${rsa_cycles} nonempty reclamation callbacks for RSA replacements, got ${positive_reclaims}; see ${serial_log}"
if ! grep -Fq "TEST:METRIC rsa_builds=${rsa_cycles} rsa_bits=${rsa_bits}" \
    "${log}"; then
  die "physical APDU probe did not record the requested RSA workload; see ${log}"
fi
printf 'PERSISTENT_RECLAIMER:TELEMETRY_PASS log=%s\n' \
  "${serial_log#${repo_root}/}"
printf 'PERSISTENT_RECLAIMER:PASS log=%s\n' "${log#${repo_root}/}"
