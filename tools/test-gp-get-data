#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${repo_root}/build/tests/gp-get-data"

"${repo_root}/tools/env" cmake \
  -S "${repo_root}/tools/tests/gp_get_data" -B "${build_dir}"
"${repo_root}/tools/env" cmake --build "${build_dir}" \
  --target gp_get_data_test
"${build_dir}/gp_get_data_test"
