#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="$(mktemp -d)"
trap 'rm -rf "${build_dir}"' EXIT

# LeakSanitizer cannot inspect subprocesses when this VM is launched under
# ptrace restrictions. AddressSanitizer and UBSan remain enabled.
export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0}"

"${CXX:-c++}" -std=c++17 -Wall -Wextra -Werror -pedantic \
  -fsanitize=address,undefined -fno-omit-frame-pointer \
  "${repo_root}/tools/tests/cap_constant_pool_validation_test.cpp" \
  -o "${build_dir}/cap_constant_pool_validation_test"
"${build_dir}/cap_constant_pool_validation_test"
