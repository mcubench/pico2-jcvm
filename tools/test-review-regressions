#!/usr/bin/env bash
# Red regressions for open findings in docs/review_claude_20261127.md.
# Each case is expected to fail until its finding is fixed. XPASS means the fix
# landed: move the case into the default list of jcsystem_transaction_applet_test.py.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
log_dir="${repo_root}/build/review-regressions"
mkdir -p "${log_dir}"
"${repo_root}/tools/build-jcsystem-transaction-probe"
"${repo_root}/tools/build-pc" --profile max_crypto > "${log_dir}/build-pc.log" 2>&1 ||
  { echo "ERROR: max_crypto PC build failed; see ${log_dir}/build-pc.log" >&2; exit 1; }

# case:finding
cases=(74:15 133:7 134:7 135:23 136:D 137:23 138:23 139:23 140:16 141:5
       142:22 143:16 144:24 145:26 146:14)
xpass=0
for entry in "${cases[@]}"; do
  case_id="${entry%%:*}" finding="${entry#*:}"
  if timeout 300 python3 "${repo_root}/tests/integration/jcsystem_transaction_applet_test.py" \
      --case "${case_id}" --log "${log_dir}/vpcd-${case_id}.log" \
      > "${log_dir}/host-${case_id}.log" 2>&1; then
    printf 'TEST:XPASS case=%s finding=#%s\n' "${case_id}" "${finding}"
    xpass=$((xpass + 1))
  else
    printf 'TEST:XFAIL case=%s finding=#%s %s\n' "${case_id}" "${finding}" \
      "$(grep -m1 'TEST:FAIL' "${log_dir}/host-${case_id}.log" || echo 'no TEST:FAIL line')"
  fi
done
printf 'TEST:SUMMARY cases=%s xpass=%s\n' "${#cases[@]}" "${xpass}"
[[ "${xpass}" -eq 0 ]]
