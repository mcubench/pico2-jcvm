#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

require_host_usb_access
require_command timeout
[[ $# -eq 1 ]] || die "usage: PICO2_HOST_USB_ACCESS=1 ./tools/test-symm-crypto-pcsc '<exact PC/SC reader name>'"

reader_name="$1"
build_dir="${repo_root}/build/symm-crypto-probe"
vectors="${build_dir}/physical-vectors.tsv"
gp_jar="${repo_root}/.local-toolchain/globalplatformpro/tool/target/gp.jar"
package_aid="A000000151000201"
applet_aid="A00000015100020101"
gp=("${repo_root}/tools/env" java -jar "${gp_jar}" "--reader=${reader_name}")
log_dir="${repo_root}/artifacts/logs"
log_file="${log_dir}/symm-crypto-kat-pcsc-$(date -u +%Y%m%dT%H%M%SZ).log"
timeout_seconds="${PICO2_APDU_TIMEOUT_SECONDS:-120}"
[[ "${timeout_seconds}" =~ ^[1-9][0-9]*$ ]] || die "PICO2_APDU_TIMEOUT_SECONDS must be a positive integer"
[[ -f "${build_dir}/output/symm-crypto-probe.cap" ]] || die "probe CAP missing; run ./tools/build-symm-crypto-probe"
[[ -s "${gp_jar}" ]] || die "GlobalPlatformPro jar not found: ${gp_jar}"

python3 - "${repo_root}" "${vectors}" <<'PY'
import importlib.util
import sys
from pathlib import Path

root, output = Path(sys.argv[1]), Path(sys.argv[2])
source = root / "tests/integration/test_symm_crypto_vpcd.py"
spec = importlib.util.spec_from_file_location("symm_crypto_vectors", source)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
vectors = (module.cipher_vectors() + module.mac_vectors() + module.sha3_vectors() +
           module.checksum_vectors() + module.gcm_vectors() + module.ccm_vectors())
with output.open("w", encoding="ascii") as stream:
    for command, expected, label in vectors:
        stream.write(f"{label}\t{command.hex()}\t{expected.hex()}\n")
print(f"VECTORS:PASS count={len(vectors)} file={output}")
PY

pcsc_refresh_if_reader_missing "${reader_name}"
gp_list="${build_dir}/physical-gp-list-$(date -u +%Y%m%dT%H%M%SZ).log"
timeout --signal=TERM --kill-after=5s 30s "${gp[@]}" --list >"${gp_list}" 2>&1 || \
  die "GPPro list failed; see ${gp_list}"
if grep -Fq "APP: ${applet_aid} " "${gp_list}" || \
   grep -Fq "PKG: ${package_aid} " "${gp_list}"; then
  die "symmetric probe AID is already present; refusing to replace existing card data"
fi

installed_here=0
cleanup() {
  local status=$?
  local cleanup_status=0
  trap - EXIT
  if (( installed_here )); then
    local list="${build_dir}/physical-gp-cleanup-$(date -u +%Y%m%dT%H%M%SZ).log"
    if timeout --signal=TERM --kill-after=5s 30s "${gp[@]}" --list >"${list}" 2>&1; then
      if grep -Fq "APP: ${applet_aid} " "${list}"; then
        timeout --signal=TERM --kill-after=5s 60s "${gp[@]}" \
          --delete "${applet_aid}" >>"${log_file}" 2>&1 || cleanup_status=1
      fi
      if grep -Fq "PKG: ${package_aid} " "${list}"; then
        timeout --signal=TERM --kill-after=5s 60s "${gp[@]}" \
          --delete "${package_aid}" >>"${log_file}" 2>&1 || cleanup_status=1
      fi
    else
      cleanup_status=1
    fi
  fi
  if (( cleanup_status != 0 )); then
    status=1
    printf 'PCSC:CLEANUP_FAIL package=%s list=%s\n' \
      "${package_aid}" "${list:-unavailable}" | tee -a "${log_file}"
  elif (( installed_here )); then
    printf 'PCSC:CLEANUP_PASS package=%s\n' "${package_aid}" | tee -a "${log_file}"
  fi
  exit "${status}"
}
trap cleanup EXIT
installed_here=1
timeout --signal=TERM --kill-after=5s 90s "${gp[@]}" \
  --install "${build_dir}/output/symm-crypto-probe.cap" >"${build_dir}/physical-install-$(date -u +%Y%m%dT%H%M%SZ).log" 2>&1 || \
  die "GPPro install failed; inspect build/symm-crypto-probe/physical-install-*.log"

"${repo_root}/tools/env" javac -d "${build_dir}" \
  "${repo_root}/tests/hardware/SymmCryptoPcscProbe.java"
mkdir -p "${log_dir}"
printf 'PCSC:LOG %s\n' "${log_file}"
timeout --signal=TERM --kill-after=3s "${timeout_seconds}s" \
  "${repo_root}/tools/env" java -cp "${build_dir}" \
  SymmCryptoPcscProbe "${reader_name}" "${vectors}" | tee "${log_file}"
