#!/usr/bin/env python3
"""Extract the ROM filesystem records from the CHOUPI host ROM-mask image.

The host image (build/choupi-pc/flash) is a fixed 512 KiB flash dump. The Pico
firmware only reads its ROM filesystem, a chain of tag/length/value records
starting at offset 0x20000 and ending at the first zero header byte. Embedding
the whole dump wasted about 489 KB of firmware flash on zero padding.

This tool writes only that record chain plus a single zero terminator. It
fails closed if any non-zero byte lies outside the extracted range, so a change
in the generator's layout cannot silently drop ROM data.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROM_FS_OFFSET = 0x20000


def walk_records(image: bytes, start: int) -> tuple[int, int]:
    """Return (terminator_offset, record_count), mirroring find_rom_file()."""
    position = start
    count = 0
    while True:
        if position >= len(image):
            raise ValueError("record chain has no zero terminator")
        header = image[position]
        if header == 0:
            return position, count
        if header & 0x40 == 0:
            raise ValueError(f"invalid record header 0x{header:02x} at 0x{position:x}")
        position += 1
        tag_length = (header >> 1) & 0x1F
        if header & 1:
            if len(image) - position < 4:
                raise ValueError(f"truncated long length at 0x{position:x}")
            data_length = int.from_bytes(image[position:position + 4], "big")
            position += 4
        else:
            if position >= len(image):
                raise ValueError(f"truncated short length at 0x{position:x}")
            data_length = image[position]
            position += 1
        # tag, data and one CRC-8 byte
        end = position + tag_length + data_length + 1
        if end > len(image):
            raise ValueError(f"record at 0x{position:x} exceeds image")
        position = end
        count += 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input", type=Path, help="host ROM-mask image")
    parser.add_argument("output", type=Path, help="trimmed ROM filesystem")
    args = parser.parse_args()

    image = args.input.read_bytes()
    if len(image) <= ROM_FS_OFFSET:
        print(f"ROMFS:ERROR image too small ({len(image)} bytes)", file=sys.stderr)
        return 1
    try:
        terminator, count = walk_records(image, ROM_FS_OFFSET)
    except ValueError as error:
        print(f"ROMFS:ERROR {error}", file=sys.stderr)
        return 1
    if count == 0:
        print("ROMFS:ERROR no ROM filesystem records", file=sys.stderr)
        return 1
    if any(image[:ROM_FS_OFFSET]):
        print("ROMFS:ERROR non-zero data before the ROM filesystem", file=sys.stderr)
        return 1
    if any(image[terminator:]):
        print("ROMFS:ERROR non-zero data after the ROM filesystem terminator",
              file=sys.stderr)
        return 1

    payload = image[ROM_FS_OFFSET:terminator + 1]
    args.output.parent.mkdir(parents=True, exist_ok=True)
    temporary = args.output.with_suffix(args.output.suffix + ".tmp")
    temporary.write_bytes(payload)
    temporary.replace(args.output)
    print(f"ROMFS:PASS records={count} bytes={len(payload)} "
          f"dropped_padding={len(image) - len(payload)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
