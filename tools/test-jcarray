#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${repo_root}/build/tests/jcarray"

"${repo_root}/tools/env" cmake -S "${repo_root}/tools/tests/jcarray" \
  -B "${build_dir}"
"${repo_root}/tools/env" cmake --build "${build_dir}" \
  --target jcarray_transient_test
ASAN_OPTIONS=detect_leaks=0 "${build_dir}/jcarray_transient_test"
