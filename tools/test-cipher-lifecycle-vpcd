#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
profile="${JCVM_PROFILE:-max_crypto}"
memory="${repo_root}/build/algtest-v182-current-empty-flash.bin"
flash_copy="${repo_root}/build/cipher-lifecycle-probe/vpcd-lifecycle-flash.bin"
log="${repo_root}/artifacts/logs/cipher-lifecycle-vpcd-$(date -u +%Y%m%dT%H%M%SZ).log"

"${repo_root}/tools/build-pc" --profile "${profile}"
"${repo_root}/tools/build-cipher-lifecycle-probe"

args=(
  --emulator "${repo_root}/build/choupi-pc/choupi"
  --memory "${memory}"
  --flash-copy "${flash_copy}"
  --cap-code "${repo_root}/build/cipher-lifecycle-probe/load-code.bin"
  --rom-mask "${repo_root}/build/choupi-pc/flash"
  --applet-aid A00000015100020301
  --package-id 56
  --passes 2
  --connect-timeout 300
  --apdu-timeout 120
  --log "${log}"
)

add_apdu() {
  args+=(--apdu "$1" --expect-apdu-response "$2")
}

add_apdu 800A000000 019000 # Build a transient key into a Key local.
add_apdu 8009000000 019000 # Build and cast the transient AES key.
add_apdu 8001000000 019000
add_apdu 8002000000 019000
add_apdu 8003000000 019000
add_apdu 8004000000 019000
add_apdu 8005000000 019000 # AES Cipher works before key clearing.
add_apdu 8006000000 019000 # Build a transient RSA private key.
add_apdu 8007000000 019000
add_apdu 8008000000 019000
add_apdu 800B000000 019000
add_apdu 00A4040008A00000015100000000 6F0A8408A0000001510000009000
add_apdu 00A4040009A0000001510002030100 9000
add_apdu 8002000000 019000 # Refill AES source after deselect.
add_apdu 8005000000 429000 # Its Cipher copy was cleared on deselect.
add_apdu 800D000000 019000 # Refill RSA source after deselect.
add_apdu 800C000000 429000 # Its Cipher copy was cleared on deselect.
add_apdu 8004000000 019000 # Refresh the Cipher copy before reader reset.
add_apdu 800B000000 019000
args+=(--reset-after-custom-apdu 19)
add_apdu 8002000000 019000 # Refill AES source after reset.
add_apdu 8005000000 429000
add_apdu 800D000000 019000 # Refill RSA source after reset.
add_apdu 800C000000 429000
args+=(
  --resume-apdu 8005000000 --expect-resume-apdu-response 429000
  --resume-apdu 800C000000 --expect-resume-apdu-response 429000
)

printf 'VPCD:LOG %s\n' "${log}"
CHOUPI_VM_TRACE_EXCEPTIONS=1 "${repo_root}/tools/env" python3 \
  "${repo_root}/tools/tests/pc_vpcd_applet_test.py" "${args[@]}"
