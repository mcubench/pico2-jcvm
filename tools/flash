#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

last_load_failure=unknown

serial=""
chipid=""
usb_path=""
image=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --serial)
      [[ $# -ge 2 && -z "$serial" ]] || die "--serial requires one serial number"
      serial="$2"
      shift 2
      ;;
    --chipid)
      [[ $# -ge 2 && -z "$chipid" ]] || die "--chipid requires one RP2350 chip ID"
      chipid="$2"
      shift 2
      ;;
    --usb-path)
      [[ $# -ge 2 && -z "$usb_path" ]] || die "--usb-path requires one USB topology path"
      usb_path="$2"
      shift 2
      ;;
    --help|-h)
      printf 'usage: ./tools/flash [--serial SERIAL | --chipid CHIPID | --usb-path PATH] <image.uf2>\n'
      exit 0
      ;;
    --*) die "unknown option: $1" ;;
    *)
      [[ -z "$image" ]] || die "usage: ./tools/flash [--serial SERIAL | --chipid CHIPID | --usb-path PATH] <image.uf2>"
      image="$1"
      shift
      ;;
  esac
done
[[ -n "$image" ]] || die "usage: ./tools/flash [--serial SERIAL | --chipid CHIPID | --usb-path PATH] <image.uf2>"
if [[ -n "$serial" && ! "$serial" =~ ^[A-Fa-f0-9]{8,32}$ ]]; then
  die "--serial must be an 8..32 character hexadecimal Pico serial"
fi
if [[ -n "$chipid" && ! "$chipid" =~ ^[A-Fa-f0-9]{16}$ ]]; then
  die "--chipid must be a 16-character hexadecimal RP2350 chip ID"
fi
if [[ -n "$usb_path" && ! "$usb_path" =~ ^[0-9]+-[0-9]+([.][0-9]+)*$ ]]; then
  die "--usb-path must be a USB topology path such as 1-3 or 1-3.2"
fi
selector_count=0
[[ -z "$serial" ]] || ((selector_count += 1))
[[ -z "$chipid" ]] || ((selector_count += 1))
[[ -z "$usb_path" ]] || ((selector_count += 1))
((selector_count <= 1)) || die "choose only one of --serial, --chipid, or --usb-path"
serial="${serial^^}"
chipid="${chipid^^}"
[[ -f "$image" ]] || die "flash image not found: ${image}"
require_host_usb_access
require_command picotool
require_command timeout
require_command stty

selector_args=()
target_sysfs_path=""
target_bus=""
target_address=""
target_product=""
target_device_serial=""
if [[ -n "$usb_path" ]]; then
  target_sysfs_path="$usb_path"
fi
capture_usb_device() {
  local device="$1"
  target_sysfs_path="${device##*/}"
  target_bus="$(<"${device}/busnum")"
  target_address="$(<"${device}/devnum")"
  target_product="$(<"${device}/idProduct")"
  if [[ -r "${device}/serial" ]]; then
    target_device_serial="$(<"${device}/serial")"
  fi
}

refresh_target_usb() {
  local device device_serial bus address info observed_chipid
  local -a bootsel_devices=() serial_devices=() chipid_runtime_devices=() rp_devices=()

  # The USB port path remains stable across runtime <-> BOOTSEL re-enumeration,
  # while the BOOTSEL ROM does not expose the firmware's USB serial number.
  if [[ -n "$target_sysfs_path" ]]; then
    device="/sys/bus/usb/devices/${target_sysfs_path}"
    if [[ -r "${device}/idVendor" && "$(<"${device}/idVendor")" == 2e8a ]]; then
      if [[ -z "$chipid" || "$(<"${device}/idProduct")" == 000f ]]; then
        capture_usb_device "$device"
        return 0
      fi
      if [[ -r "${device}/serial" ]]; then
        device_serial="$(<"${device}/serial")"
        if [[ "${device_serial^^}" == "$chipid" ]]; then
          capture_usb_device "$device"
          return 0
        fi
      fi
    fi
    if [[ -n "$usb_path" ]]; then
      return 1
    fi
  fi

  for device in /sys/bus/usb/devices/*; do
    [[ -r "${device}/idVendor" && -r "${device}/idProduct" &&
       -r "${device}/busnum" && -r "${device}/devnum" ]] || continue
    [[ "$(<"${device}/idVendor")" == 2e8a ]] || continue
    rp_devices+=("${device}")
    if [[ "$(<"${device}/idProduct")" == 000f ]]; then
      bootsel_devices+=("${device}")
    fi
    if [[ -n "$serial" && -r "${device}/serial" ]]; then
      device_serial="$(<"${device}/serial")"
      if [[ "${device_serial^^}" == "$serial" ]]; then
        serial_devices+=("${device}")
      fi
    fi
    if [[ -n "$chipid" && "$(<"${device}/idProduct")" != 000f &&
          -r "${device}/serial" ]]; then
      device_serial="$(<"${device}/serial")"
      if [[ "${device_serial^^}" == "$chipid" ]]; then
        chipid_runtime_devices+=("${device}")
      fi
    fi
  done

  if [[ -n "$chipid" ]]; then
    if ((${#chipid_runtime_devices[@]} == 1)); then
      capture_usb_device "${chipid_runtime_devices[0]}"
      return 0
    fi
    if ((${#chipid_runtime_devices[@]} > 1)); then
      return 1
    fi
    # BOOTSEL drops the runtime USB serial. With multiple BOOTSEL boards,
    # select by the stable RP2350 chip ID reported by the ROM, not USB order.
    for device in "${bootsel_devices[@]}"; do
      bus="$(<"${device}/busnum")"
      address="$(<"${device}/devnum")"
      if ! info="$(timeout --signal=TERM --kill-after=2s 4s \
          picotool info --device --bus "$bus" --address "$address" 2>&1)"; then
        continue
      fi
      observed_chipid="$(sed -nE 's/^[[:space:]]*chipid:[[:space:]]*0x?([[:xdigit:]]{16})[[:space:]]*$/\1/p' <<<"$info" | tr '[:lower:]' '[:upper:]')"
      if [[ "$observed_chipid" == "$chipid" ]]; then
        capture_usb_device "$device"
        return 0
      fi
    done
    return 1
  fi

  if ((${#serial_devices[@]} == 1)); then
    capture_usb_device "${serial_devices[0]}"
    return 0
  fi
  # A unique BOOTSEL device is unambiguous even though ROM has no serial. This
  # also supports flashing a board that was already inserted in BOOTSEL.
  if ((${#bootsel_devices[@]} == 1)); then
    capture_usb_device "${bootsel_devices[0]}"
    return 0
  fi
  if ((${#rp_devices[@]} == 1)); then
    capture_usb_device "${rp_devices[0]}"
    return 0
  fi
  return 1
}

set_target_selector() {
  [[ -n "$target_bus" && -n "$target_address" ]] || \
    die "cannot select the identified RP-series USB device by bus and address"
  # Resolve serial/chip ID through sysfs first, then use the live bus/address
  # for this picotool invocation. picotool's --ser matches the bootrom serial,
  # not firmware CDC serials, and becomes ambiguous with multiple runtime
  # devices attached. Refresh this target again after each USB re-enumeration.
  selector_args=(--bus "$target_bus" --address "$target_address")
}

rp_usb_present() {
  refresh_target_usb
}

wait_for_rp_usb() {
  local limit="$1"
  local elapsed
  for ((elapsed = 0; elapsed <= limit; elapsed++)); do
    if rp_usb_present; then
      printf 'FLASH:USB RP-series device detected wait_seconds=%s\n' "${elapsed}"
      return 0
    fi
    if ((elapsed == 0)); then
      printf 'FLASH:USB RP-series device absent; waiting up to %s seconds for re-enumeration\n' "${limit}"
    fi
    if ((elapsed < limit)); then
      sleep 1
    fi
  done
  printf 'FLASH:USB device wait timed out after %s seconds\n' "${limit}"
  return 1
}

is_bootsel() {
  local info
  refresh_target_usb || return 1
  set_target_selector
  if ! info="$(timeout --signal=TERM --kill-after=2s 4s picotool info "${selector_args[@]}" -a 2>&1)"; then
    return 1
  fi
  if [[ -n "$chipid" ]] &&
      ! grep -Eqi "^[[:space:]]*chipid:[[:space:]]*0x?${chipid}[[:space:]]*$" <<<"$info"; then
    printf 'FLASH:TARGET_ID_MISMATCH expected=%s\n' "$chipid"
    return 1
  fi
  grep -Eq 'boot type:[[:space:]]*bootsel' <<<"${info}"
}

wait_for_bootsel() {
  local limit="$1"
  local elapsed
  for ((elapsed = 0; elapsed <= limit; elapsed++)); do
    if is_bootsel; then
      printf 'FLASH:BOOTSEL detected wait_seconds=%s\n' "${elapsed}"
      return 0
    fi
    if ((elapsed < limit)); then
      sleep 1
    fi
  done
  printf 'FLASH:BOOTSEL wait timed out after %s seconds\n' "${limit}"
  return 1
}

request_bootsel() {
  local attempt="$1"
  printf 'FLASH:BOOTSEL request attempt=%s method=picotool\n' "${attempt}"
  if timeout --signal=TERM --kill-after=2s 8s picotool reboot "${selector_args[@]}" -F -u; then
    return 0
  fi
  printf 'FLASH:BOOTSEL picotool request did not complete cleanly\n'
  return 0
}

request_cdc_bootsel() {
  local ports=()
  local port
  local reset_serial="$serial"
  if [[ -n "$usb_path" ]]; then
    local tty sysfs_tty
    local -a path_ports=()
    shopt -s nullglob
    for tty in /sys/class/tty/ttyACM*; do
      sysfs_tty="$(readlink -f "$tty")"
      if [[ "$sysfs_tty" == *"/${usb_path}/${usb_path}:1.0/tty/"* ]]; then
        path_ports+=("/dev/${tty##*/}")
      fi
    done
    shopt -u nullglob
    if ((${#path_ports[@]} != 1)); then
      printf 'FLASH:BOOTSEL CDC fallback skipped; USB path %s maps to %s CDC ports\n' "$usb_path" "${#path_ports[@]}"
      return 1
    fi
    ports=("${path_ports[0]}")
  fi
  if [[ -z "$reset_serial" && -n "$chipid" ]]; then
    reset_serial="$target_device_serial"
  fi
  shopt -s nullglob
  if [[ -n "$usb_path" ]]; then
    :
  elif [[ -n "$reset_serial" ]]; then
    # Product strings are firmware-controlled and may change (for example,
    # "Pico2 JCVM CCID"). Select CDC by the stable Pico USB serial instead.
    ports=(/dev/serial/by-id/*"${reset_serial}"*-if00)
  else
    ports=(/dev/serial/by-id/usb-Raspberry_Pi_Pico_*)
    if ((${#ports[@]} != 1)); then
      ports=(/dev/ttyACM*)
    fi
  fi
  shopt -u nullglob
  if ((${#ports[@]} != 1)); then
    printf 'FLASH:BOOTSEL CDC fallback skipped; found %s unambiguous Pico serial ports\n' "${#ports[@]}"
    return 1
  fi
  port="${ports[0]}"
  printf 'FLASH:BOOTSEL request method=cdc-1200 port=%s\n' "${port}"
  if timeout --signal=TERM --kill-after=1s 3s stty -F "${port}" 1200 raw -echo; then
    return 0
  fi
  printf 'FLASH:BOOTSEL CDC 1200-baud request did not complete cleanly\n'
  return 1
}

run_load() {
  local mode="$1"
  local load_capture
  local load_status
  local normalized_load
  local -a load_command=(picotool load)
  load_capture="$(mktemp)"
  last_load_failure=unknown
  if [[ "${mode}" == force ]]; then
    load_command+=(-f)
  fi
  load_command+=("${selector_args[@]}" -v -x "${image}")
  printf 'FLASH:LOAD mode=%s\n' "${mode}"
  set +e
  timeout --signal=TERM --kill-after=5s 60s "${load_command[@]}" 2>&1 | tee "${load_capture}"
  load_status=${PIPESTATUS[0]}
  set -e
  normalized_load="$(tr '\r' '\n' < "${load_capture}")"
  rm -f "${load_capture}"
  if ((load_status != 0)); then
    printf 'FLASH:LOAD failed status=%s\n' "${load_status}"
    if grep -qi 'Unable to locate reset interface' <<<"${normalized_load}"; then
      last_load_failure=reset-interface-missing
    elif grep -qi 'No accessible RP-series device in BOOTSEL mode' <<<"${normalized_load}"; then
      last_load_failure=runtime-not-bootsel
    elif grep -qi 'Failed to initialise libUSB' <<<"${normalized_load}"; then
      last_load_failure=libusb-init
    fi
    return 1
  fi
  if ! grep -Eq 'Loading into Flash:.*100%' <<<"${normalized_load}" || \
      ! grep -q 'The device was rebooted to start the application' <<<"${normalized_load}"; then
    printf 'FLASH:LOAD returned without a confirmed 100%% flash and application reboot\n'
    return 1
  fi
  printf 'FLASH:PASS image=%s\n' "${image}"
  return 0
}

recover_bootsel() {
  local attempt

  # A missing picotool reset interface is deterministic for this composite
  # CDC+CCID device. Do not spend the generic 45-second polling window waiting
  # for a reboot that picotool could not request; use the CDC reset now.
  if [[ "${last_load_failure}" == reset-interface-missing ]]; then
    printf 'FLASH:BOOTSEL recovery=cdc-after-missing-reset-interface\n'
    if request_cdc_bootsel && wait_for_bootsel 20; then
      return 0
    fi
  elif [[ "${last_load_failure}" == runtime-not-bootsel ]]; then
    printf 'FLASH:BOOTSEL recovery=cdc-after-runtime-load-rejection\n'
    if request_cdc_bootsel && wait_for_bootsel 20; then
      return 0
    fi
  elif [[ "${last_load_failure}" == libusb-init ]]; then
    die "picotool cannot initialize libusb; no BOOTSEL or reset operation is possible in this host context"
  fi

  if wait_for_bootsel 45; then
    return 0
  fi
  for attempt in 1 2 3; do
    request_bootsel "${attempt}"
    if wait_for_bootsel 20; then
      return 0
    fi
    if ((attempt == 1)); then
      request_cdc_bootsel || true
      if wait_for_bootsel 20; then
        return 0
      fi
    fi
  done
  die "Pico did not enter BOOTSEL after force-load, delayed polling, three reboot requests, and CDC reset fallback"
}

printf 'FLASH:IMAGE path=%s\n' "${image}"
wait_for_rp_usb 120 || die "no RP-series USB device appeared; reconnect the Pico and retry"
if is_bootsel; then
  printf 'FLASH:BOOTSEL already available\n'
  run_load normal || die "direct BOOTSEL flash failed"
else
  if run_load force; then
    exit 0
  fi
  if recover_bootsel; then
    run_load normal || die "retry from BOOTSEL failed"
  fi
fi
