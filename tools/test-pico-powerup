#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

[[ $# -le 1 ]] || die "usage: PICO2_HOST_USB_ACCESS=1 ./tools/test-pico-powerup [reader-name]"
require_command timeout
require_command tee
require_command grep
require_host_usb_access

attempts="${PICO2_POWERUP_ATTEMPTS:-3}"
[[ "${attempts}" =~ ^[1-5]$ ]] || \
  die "PICO2_POWERUP_ATTEMPTS must be an integer from 1 to 5"
list_timeout="${PICO2_POWERUP_LIST_TIMEOUT_SECONDS:-20}"
[[ "${list_timeout}" =~ ^[1-9][0-9]*$ ]] || \
  die "PICO2_POWERUP_LIST_TIMEOUT_SECONDS must be a positive integer"
apdu_timeout="${PICO2_APDU_TIMEOUT_SECONDS:-20}"
[[ "${apdu_timeout}" =~ ^[1-9][0-9]*$ ]] || \
  die "PICO2_APDU_TIMEOUT_SECONDS must be a positive integer"
expected_version="${JCALGTEST_EXPECTED_VERSION:-1.8.2_jc305}"
[[ "${expected_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+_jc305$ ]] || \
  die "JCALGTEST_EXPECTED_VERSION must look like 1.8.2_jc305"

reader_name="${1:-Pico 2 CHOUPI CCID [JCVM CCID] (D92E743D5F640C0F) 00 00}"
gp_jar="${repo_root}/.local-toolchain/globalplatformpro/tool/target/gp.jar"
[[ -s "${gp_jar}" ]] || die "GlobalPlatformPro jar not found: ${gp_jar}"

PICO2_HOST_USB_ACCESS=1 sudo -n /usr/local/sbin/pico2-pcsc-reader

mkdir -p "${repo_root}/artifacts/logs"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log="${repo_root}/artifacts/logs/pico-powerup-persistence-${timestamp}.log"
printf 'PERSISTENCE:START reader=%s\n' "${reader_name}" | tee "${log}"

registry_verified=0
for ((attempt = 1; attempt <= attempts; ++attempt)); do
  printf 'PERSISTENCE:REGISTRY_ATTEMPT attempt=%s/%s\n' \
    "${attempt}" "${attempts}" | tee -a "${log}"
  if [[ "${attempt}" != 1 ]]; then
    PICO2_HOST_USB_ACCESS=1 sudo -n /usr/local/sbin/pico2-pcsc-reader
  fi
  listing=""
  list_status=0
  if listing="$(timeout --signal=TERM --kill-after=2s \
      "${list_timeout}s" "${repo_root}/tools/env" java -jar "${gp_jar}" \
      --reader "${reader_name}" --list 2>&1)"; then
    list_status=0
  else
    list_status=$?
  fi
  printf '%s\n' "${listing}" | tee -a "${log}"
  if [[ "${list_status}" == 0 ]] && \
      grep -Fq 'APP: 4A43416C675465737431 (SELECTABLE)' <<<"${listing}" && \
      grep -Fq 'PKG: 4A43416C6754657374 (LOADED)' <<<"${listing}"; then
    registry_verified=1
    break
  fi
  printf 'PERSISTENCE:REGISTRY_RETRY attempt=%s exit=%s\n' \
    "${attempt}" "${list_status}" | tee -a "${log}"
done
[[ "${registry_verified}" == 1 ]] || \
  die "JCAlgTest package/applet registry was not confirmed after ${attempts} attempts; see ${log}"

probe_verified=0
for ((attempt = 1; attempt <= attempts; ++attempt)); do
  printf 'PERSISTENCE:APDU_ATTEMPT attempt=%s/%s timeout=%ss\n' \
    "${attempt}" "${attempts}" "${apdu_timeout}" | tee -a "${log}"
  if [[ "${attempt}" != 1 ]]; then
    PICO2_HOST_USB_ACCESS=1 sudo -n /usr/local/sbin/pico2-pcsc-reader
  fi
  probe_status=0
  if PICO2_HOST_USB_ACCESS=1 \
      JCALGTEST_EXPECTED_VERSION="${expected_version}" \
      PICO2_APDU_TIMEOUT_SECONDS="${apdu_timeout}" \
      "${repo_root}/tools/probe-jc-algtest" --version-only 2>&1 | \
      tee -a "${log}"; then
    probe_status=0
  else
    probe_status=$?
  fi
  if [[ "${probe_status}" == 0 ]] && \
      grep -Fq "TEST:PASS jc_algtest_persistence_probe version=${expected_version}" \
        "${log}"; then
    probe_verified=1
    break
  fi
  printf 'PERSISTENCE:APDU_RETRY attempt=%s exit=%s\n' \
    "${attempt}" "${probe_status}" | tee -a "${log}"
done
[[ "${probe_verified}" == 1 ]] || \
  die "JCAlgTest process probe did not confirm the restored applet after ${attempts} attempts; see ${log}"

printf 'PERSISTENCE:PASS registry_applet_and_jcsystem_verified power_cycle=not_verified_by_script log=%s\n' \
  "${log}"
