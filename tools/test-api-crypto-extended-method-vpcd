#!/usr/bin/env python3
"""Exercise an upstream Crypto API method whose CAP header is extended."""

from __future__ import annotations

import hashlib
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CAP = ROOT / "AlgTest_JavaCard/deploy/caps/AlgTestApiCrypto_305.cap"
CAP_SHA256 = "f3dc5edd5b65817c8663ea1018128448052816c1a323c8cc2211027e9f8e4899"
APPLET_AID = bytes.fromhex("4A43416C675465737441706943727931")


def main() -> int:
    digest = hashlib.sha256(CAP.read_bytes()).hexdigest()
    if digest != CAP_SHA256:
        raise SystemExit(
            f"CAP:FAIL upstream Crypto CAP hash changed: {digest}"
        )

    sys.path.insert(0, str(ROOT / "tools/tests"))
    from pc_vpcd_multipackage_test import load_code

    code, package_aid, applet_aids = load_code(CAP)
    if applet_aids != [APPLET_AID]:
        raise SystemExit(
            "CAP:FAIL unexpected upstream Crypto applet AIDs: "
            + ",".join(aid.hex().upper() for aid in applet_aids)
        )

    build = ROOT / "build"
    load_code_path = build / "algtestapi-crypto-305-extended-method-load-code.bin"
    memory = build / "algtestapi-crypto-305-extended-method-memory.bin"
    load_code_path.write_bytes(code)
    memory.write_bytes(b"")

    # ApiTestCatalogCrypto's CIPHER_CRYPT entry for
    # ALG_AES_BLOCK_128_CBC_NOPAD sends this APDU. The applet dispatches to
    # ApiTestCryptoCipher.crypt(), whose 20 local slots require an extended
    # method header. Response data 00002001 means no exception, 32 output
    # bytes, and a passing known-answer comparison.
    command = [
        str(ROOT / "tools/test-pc-vpcd-applet"),
        "--passes", "1",
        "--memory", str(memory),
        "--cap-code", str(load_code_path),
        "--package-id", "62",
        "--applet-aid", APPLET_AID.hex(),
        "--apdu", "B0838305010D00",
        "--expect-apdu-response", "000020019000",
        "--log", str(ROOT / "artifacts/logs/rv28-extended-crypto-crypt-api-vpcd-20261106.log"),
    ]
    result = subprocess.run(command, cwd=ROOT, check=False)
    if result.returncode == 0:
        print(
            f"EXTENDED_METHOD:PASS package_aid={package_aid.hex().upper()} "
            f"applet_aid={APPLET_AID.hex().upper()} "
            f"cap_sha256={digest} response=000020019000"
        )
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
