#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'USAGE'
Usage: PICO2_HOST_USB_ACCESS=1 ./tools/test-jcalgtest-support-vpcd

Runs an unchanged JCAlgTest operation against an empty PC/SC-published VPCD
reader. Set JCALGTEST_OPERATION to ALG_SUPPORT_BASIC, ALG_SUPPORT_EXTENDED,
ALG_PERFORMANCE_STATIC, or ALG_PERFORMANCE_VARIABLE (default ALG_SUPPORT_EXTENDED),
JCALGTEST_OBJECT_DELETION=1, JCALGTEST_VPCD_READER, and JCALGTEST_VPCD_ENDPOINT
as needed. Set JCALGTEST_SUPPORT_TIMEOUT_SECONDS to choose a timeout from 1 to
10800 seconds. To resume a prior RP2350 overlay, set
JCALGTEST_VPCD_RESUME_DIR to its result directory and
JCALGTEST_VPCD_RESUME_MEMORY_DIR to a result directory containing a matching
empty-card.bin and empty-card.bin.cap-registry pair. Provide client prompt
answers in JCALGTEST_STDIN_LINES (newline-separated). Full logs and intermediate
artifacts go under artifacts/results/.
USAGE
  exit 0
fi

operation="${JCALGTEST_OPERATION:-ALG_SUPPORT_EXTENDED}"
case "${operation}" in
  ALG_SUPPORT_BASIC|ALG_SUPPORT_EXTENDED|ALG_PERFORMANCE_STATIC|ALG_PERFORMANCE_VARIABLE)
    ;;
  *)
    die "unsupported JCAlgTest operation '${operation}' (choose ALG_SUPPORT_BASIC, ALG_SUPPORT_EXTENDED, ALG_PERFORMANCE_STATIC, or ALG_PERFORMANCE_VARIABLE)"
    ;;
esac

require_host_usb_access
require_command timeout
require_command grep
require_command stdbuf
require_command sha256sum
"${repo_root}/tools/build-jcalgtest-load-code" >/dev/null

reader="${JCALGTEST_VPCD_READER:-Virtual PCD 00 00}"
endpoint="${JCALGTEST_VPCD_ENDPOINT:-127.0.0.1:35963}"
object_deletion="${JCALGTEST_OBJECT_DELETION:-0}"
support_timeout="${JCALGTEST_SUPPORT_TIMEOUT_SECONDS:-3600}"
[[ "${support_timeout}" =~ ^[1-9][0-9]*$ ]] ||
  die "JCALGTEST_SUPPORT_TIMEOUT_SECONDS must be a positive integer"
(( support_timeout <= 10800 )) ||
  die "JCALGTEST_SUPPORT_TIMEOUT_SECONDS must not exceed 10800"
[[ "${object_deletion}" == 0 || "${object_deletion}" == 1 ]] ||
  die "JCALGTEST_OBJECT_DELETION must be 0 or 1"
applet_aid="4A43416C675465737431"
emulator="${JCALGTEST_VPCD_EMULATOR:-${repo_root}/build/choupi-pc/choupi}"
rom_mask="${JCALGTEST_VPCD_ROM_MASK:-${repo_root}/build/choupi-pc/flash}"
gp_jar="${repo_root}/.local-toolchain/globalplatformpro/tool/target/gp.jar"
client="${JCALGTEST_CLIENT_JAR:-${repo_root}/tests/fixtures/external/jcalgtest/1.8.5/client/AlgTestJClient_v1.8.5.jar}"
cap="$("${repo_root}/tools/fixture-path" jcalgtest.cap)"
reference="${repo_root}/tests/fixtures/reference/jcalgtest/1.8.5/jcardsim-alg-support-extended.csv"
expected="${repo_root}/build/javacard-support/jcalgtest-supported.csv"
resume_dir="${JCALGTEST_VPCD_RESUME_DIR:-}"
resume_memory_dir="${JCALGTEST_VPCD_RESUME_MEMORY_DIR:-}"
if [[ -n "${resume_dir}" ]]; then
  [[ -s "${resume_dir}/rp2350-overlay.flash" ]] ||
    die "resume overlay is missing: ${resume_dir}/rp2350-overlay.flash"
  [[ -s "${resume_memory_dir}/empty-card.bin" && \
     -s "${resume_memory_dir}/empty-card.bin.cap-registry" ]] ||
    die "resume requires a saved PC memory/registry pair; set JCALGTEST_VPCD_RESUME_MEMORY_DIR"
elif [[ -n "${resume_memory_dir}" ]]; then
  die "JCALGTEST_VPCD_RESUME_MEMORY_DIR requires JCALGTEST_VPCD_RESUME_DIR"
fi
rp2350_overlay="${JCALGTEST_RP2350_OVERLAY:-0}"
[[ "${rp2350_overlay}" == 0 || "${rp2350_overlay}" == 1 ]] ||
  die "JCALGTEST_RP2350_OVERLAY must be 0 or 1"
build_directory="${repo_root}/build/choupi-pc"
if [[ "${rp2350_overlay}" == 1 ]]; then
  build_directory="${repo_root}/build/choupi-pc-rp2350-overlay"
  "${repo_root}/tools/build-pc" --profile max_crypto --rp2350-overlay >/dev/null
fi
emulator="${JCALGTEST_VPCD_EMULATOR:-${build_directory}/choupi}"
rom_mask="${JCALGTEST_VPCD_ROM_MASK:-${build_directory}/flash}"

for input in "${emulator}" "${rom_mask}" "${gp_jar}" "${client}" "${cap}" \
    "${reference}" "${expected}"; do
  [[ -s "${input}" ]] || die "required input is missing: ${input}"
done
client_hash="$(sha256sum "${client}" | cut -d ' ' -f 1)"
[[ "${client_hash}" == "b6a753be280a225efc1b237fd53319c01946af15b4f2ae2e57adaad8e3eacec3" ]] ||
  die "the supplied JCAlgTest client must be 1.8.5 (expected hash pinned in tests/README.md): ${client_hash}"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
out_dir="${repo_root}/artifacts/results/jcalgtest-support-vpcd-${timestamp}"
mkdir -p "${out_dir}"
memory="${out_dir}/empty-card.bin"
overlay_flash="${JCALGTEST_OVERLAY_FLASH:-${out_dir}/rp2350-overlay.flash}"
client_log="${out_dir}/client.log"
emulator_log="${out_dir}/emulator.log"
cp "${expected}" "${out_dir}/expected-support.csv"
if [[ -n "${resume_dir}" ]]; then
  cp "${resume_dir}/rp2350-overlay.flash" "${overlay_flash}"
  cp "${resume_memory_dir}/empty-card.bin" "${memory}"
  cp "${resume_memory_dir}/empty-card.bin.cap-registry" "${memory}.cap-registry"
else
  : > "${memory}"
fi

reader_found=false
for attempt in 1 2 3; do
  inventory="${out_dir}/reader-inventory-${attempt}.log"
  timeout --signal=TERM --kill-after=2s 20s \
    env PICO2_HOST_USB_ACCESS=1 "${repo_root}/tools/list-readers" --timeout 15 \
    > "${inventory}" 2>&1 || true
  if grep -Fq "${reader}" "${inventory}"; then
    reader_found=true
    break
  fi
  sleep 1
done
[[ "${reader_found}" == true ]] || {
  for inventory in "${out_dir}"/reader-inventory-*.log; do
    [[ -f "${inventory}" ]] || continue
    printf '%s (last 40 lines; full log retained):\n' "${inventory}" >&2
    tail -n 40 "${inventory}" >&2
  done
  die "VPCD PC/SC reader was not published: ${reader}"
}

emulator_args=(-m "${memory}" -s --vpcd "${endpoint}"
  --vpcd-idle-timeout 3600 --applet-aid "${applet_aid}"
  --rom-mask "${rom_mask}")
if [[ -n "${resume_dir}" ]]; then
  emulator_args+=(--resume)
else
  emulator_args+=(--package-id 63
    --cap-code "${repo_root}/build/tests/jcalgtest/algtest-v184-load-code.bin")
fi
PICO2_RP2350_OVERLAY_FLASH="${overlay_flash}" \
PICO2_TEST_OBJECT_DELETION="${object_deletion}" \
  "${repo_root}/tools/env" "${emulator}" "${emulator_args[@]}" \
  > "${emulator_log}" 2>&1 &
emulator_pid=$!
cleanup() {
  if kill -0 "${emulator_pid}" 2>/dev/null; then
    kill -TERM "${emulator_pid}" 2>/dev/null || true
    wait "${emulator_pid}" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# Let the emulator attach before the PC/SC presence probe starts polling.
sleep 1
if ! timeout --signal=TERM --kill-after=2s 30s \
    "${repo_root}/tools/env" java \
    "${repo_root}/tests/hardware/VpcdPresenceProbe.java" "${reader}" 8000 \
    --require-present > "${out_dir}/reader-ready.log" 2>&1; then
  cat "${emulator_log}" >&2
  cat "${out_dir}/reader-ready.log" >&2
  die "VPCD card did not become present"
fi

gp_timeout() {
  timeout --signal=TERM --kill-after=5s 120s \
    "${repo_root}/tools/env" java -jar "${gp_jar}" \
    --reader "${reader}" "$@"
}
if [[ -n "${resume_dir}" ]]; then
  gp_timeout --list > "${out_dir}/list-resumed.log" 2>&1 || {
    cat "${out_dir}/list-resumed.log" >&2
    die "GPPro could not list the resumed VPCD card"
  }
  grep -Fq 'PKG: 4A43416C6754657374 (LOADED)' "${out_dir}/list-resumed.log" || {
    cat "${out_dir}/list-resumed.log" >&2
    die "resumed JCAlgTest package is not listed as loaded"
  }
  grep -Fq 'APP: 4A43416C675465737431 (SELECTABLE)' "${out_dir}/list-resumed.log" || {
    cat "${out_dir}/list-resumed.log" >&2
    die "resumed JCAlgTest applet is not listed as selectable"
  }
else
  gp_timeout --list > "${out_dir}/list-before.log" 2>&1 || {
    cat "${out_dir}/list-before.log" >&2
    die "GPPro could not list the empty VPCD card"
  }
  if grep -Fq 'PKG: 4A43416C6754657374 ' "${out_dir}/list-before.log" ||
     grep -Fq 'APP: 4A43416C675465737431 ' "${out_dir}/list-before.log"; then
    cat "${out_dir}/list-before.log" >&2
    die "fresh VPCD card unexpectedly contains JCAlgTest"
  fi
  gp_timeout --install "${cap}" > "${out_dir}/install.log" 2>&1 || {
    cat "${out_dir}/install.log" >&2
    die "GPPro LOAD/INSTALL of upstream JCAlgTest failed"
  }
  gp_timeout --list > "${out_dir}/list-after.log" 2>&1 || {
    cat "${out_dir}/list-after.log" >&2
    die "GPPro could not list the card after installation"
  }
  grep -Fq 'PKG: 4A43416C6754657374 (LOADED)' "${out_dir}/list-after.log" || {
    cat "${out_dir}/list-after.log" >&2
    die "JCAlgTest package is not listed as loaded"
  }
  grep -Fq 'APP: 4A43416C675465737431 (SELECTABLE)' "${out_dir}/list-after.log" || {
    cat "${out_dir}/list-after.log" >&2
    die "JCAlgTest applet is not listed as selectable"
  }
fi

client_args=(-op "${operation}" -outpath "${out_dir}")
if [[ -z "${resume_dir}" ]]; then
  client_args+=(-fresh)
fi
client_status=0
JCALGTEST_TIMEOUT_SECONDS="${support_timeout}" \
    "${repo_root}/tools/run-jcalgtest" --client-jar "${client}" \
    --reader-name "${reader}" \
    "${client_args[@]}" > "${client_log}" 2>&1 || client_status=$?
if [[ "${object_deletion}" == 1 ]]; then
  python3 "${repo_root}/tools/check-object-deletion-headroom.py" \
    "${emulator_log}" > "${out_dir}/headroom.log" 2>&1 || {
      cat "${out_dir}/headroom.log" >&2
      cat "${client_log}" >&2
      die "object-deletion headroom acceptance failed; see ${out_dir}"
    }
  cat "${out_dir}/headroom.log"
fi
if (( client_status != 0 )); then
  cat "${client_log}" >&2
  cat "${emulator_log}" >&2
  die "JCAlgTest operation ${operation} failed; see ${out_dir}"
fi

if grep -Eq 'ERROR: unknown option|ERROR: Unexpected exception|ERROR: Unable to measure|Exception in thread' \
    "${client_log}"; then
  cat "${client_log}" >&2
  die "JCAlgTest client reported an operation or runtime failure; see ${out_dir}"
fi
mapfile -t result_csvs < <(find "${out_dir}" -maxdepth 1 -type f \
  -iname '*.csv' -print)
(( ${#result_csvs[@]} > 0 )) || {
  cat "${client_log}" >&2
  die "JCAlgTest produced no CSV result; see ${out_dir}"
}

if [[ "${operation}" == ALG_SUPPORT_EXTENDED ]]; then
  mapfile -t reports < <(find "${out_dir}" -maxdepth 1 -type f \
    -iname '*ALGSUPPORT*.csv' -print | sort)
  [[ "${#reports[@]}" -eq 1 ]] || {
    find "${out_dir}" -maxdepth 1 -type f -printf '%f\n' >&2
    die "expected one JCAlgTest support CSV, found ${#reports[@]}"
  }
  python3 "${repo_root}/tools/compare-jcalgtest-support.py" "${reports[0]}" \
    "${reference}" --expected-support "${out_dir}/expected-support.csv" \
    > "${out_dir}/comparison.log" 2>&1 || {
    cat "${out_dir}/comparison.log" >&2
    die "JCAlgTest support comparison failed; see ${out_dir}"
  }
  cat "${out_dir}/comparison.log"
fi
printf 'JCALGTEST_VPCD:PASS operation=%s reader=%s artifacts=%s\n' \
  "${operation}" "${reader}" "${out_dir#${repo_root}/}"
