#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${repo_root}/build/tests/unit/apdu-parser-fuzz"

"${repo_root}/tools/env" cmake -S "${repo_root}/tests/unit/apdu_parser_fuzz" \
  -B "${build_dir}"
"${repo_root}/tools/env" cmake --build "${build_dir}" \
  --target apdu_parser_fuzz
ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 \
UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
  "${build_dir}/apdu_parser_fuzz"
