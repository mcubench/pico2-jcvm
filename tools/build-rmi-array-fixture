#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_dir="${repo_root}/tools/tests/rmi_array_fixture"
build_dir="${repo_root}/build/rmi-array-fixture"
kit="${repo_root}/AlgTest_JavaCard/ext/jc305u3_kit"
java8_home="${JAVA8_HOME:-${repo_root}/.local-toolchain/java8}"

[[ -x "${java8_home}/bin/javac" ]] || {
  printf 'ERROR: Java 8 compiler not found: %s\n' "${java8_home}" >&2
  exit 1
}
mkdir -p "${build_dir}/classes" "${build_dir}/output"

"${repo_root}/tools/env" "${java8_home}/bin/javac" \
  -source 1.7 -target 1.7 -Xlint:-options \
  -classpath "${kit}/lib/api_classic.jar" \
  -d "${build_dir}/classes" "${source_dir}"/*.java \
  > "${build_dir}/compile.log" 2>&1

cat > "${build_dir}/build.xml" <<EOF_ANT
<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." default="build" name="RmiArrayFixture">
  <property name="repo" location="${repo_root}"/>
  <property name="kit" location="\${repo}/AlgTest_JavaCard/ext/jc305u3_kit"/>
  <target name="build">
    <java classname="com.sun.javacard.converter.Main" fork="true"
          dir="\${basedir}/output" failonerror="true">
      <classpath><pathelement location="\${kit}/lib/tools.jar"/></classpath>
      <arg value="-i"/>
      <arg value="-classdir"/><arg value="\${basedir}/classes"/>
      <arg value="-exportpath"/><arg value="\${kit}/api_export_files"/>
      <arg value="-d"/><arg value="\${basedir}/output"/>
      <arg value="-out"/><arg value="JCA"/>
      <arg value="-applet"/><arg value="0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x01:0x01"/>
      <arg value="rmi.fixture.RmiApplet"/>
      <arg value="rmi.fixture"/>
      <arg value="0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x01"/>
      <arg value="1.0"/>
    </java>
  </target>
</project>
EOF_ANT

JAVA_HOME="${java8_home}" "${repo_root}/tools/env" ant \
  -f "${build_dir}/build.xml" > "${build_dir}/build.log" 2>&1

"${repo_root}/tools/env" java \
  -cp "${kit}/lib/tools.jar" com.sun.javacard.jcasm.cap.Main \
  -nobanner -o "${build_dir}/output/fixture.cap" \
  "${build_dir}/output/rmi/fixture/javacard/fixture.jca" \
  > "${build_dir}/capgen.log" 2>&1

python3 - "${build_dir}/output/fixture.cap" "${build_dir}/rmi-fixture-load-code.bin" \
  "${build_dir}/Class.cap" <<'PY'
import sys
from zipfile import ZipFile

source, load_target, class_target = sys.argv[1:]
components = ("Header", "Directory", "Applet", "Import", "ConstantPool",
              "Class", "Method", "StaticField", "RefLocation", "Descriptor")
with ZipFile(source) as cap:
    chunks = []
    for component in components:
        name = f"rmi/fixture/javacard/{component}.cap"
        try:
            content = cap.read(name)
        except KeyError as error:
            raise SystemExit(f"CAP is missing required component {name}") from error
        chunks.append(content)
        if component == "Class":
            with open(class_target, "wb") as output:
                output.write(content)
with open(load_target, "wb") as output:
    for content in chunks:
        output.write(content)
PY

inspect_dir="${repo_root}/build/tests/rmi-array-fixture"
"${repo_root}/tools/env" cmake -S "${source_dir}" -B "${inspect_dir}" \
  -DCMAKE_BUILD_TYPE=Release > "${build_dir}/inspect-configure.log"
"${repo_root}/tools/env" cmake --build "${inspect_dir}" \
  --target rmi_array_cap_inspect --parallel 2 > "${build_dir}/inspect-build.log"
"${inspect_dir}/rmi_array_cap_inspect" "${build_dir}/Class.cap" \
  | tee "${build_dir}/remote-methods.txt"
grep -Eq 'hash=a336 .*types=dd$' "${build_dir}/remote-methods.txt" || {
  printf 'ERROR: CAP is missing echoInts(int[]):int[] metadata\n' >&2
  exit 1
}
grep -Eq 'hash=bb6c .*types=d4$' "${build_dir}/remote-methods.txt" || {
  printf 'ERROR: CAP is missing sumInts(int[]):short metadata\n' >&2
  exit 1
}
grep -Eq 'hash=ec5c .*types=1$' "${build_dir}/remote-methods.txt" || {
  printf 'ERROR: CAP is missing throwCryptoReason() metadata\n' >&2
  exit 1
}
grep -Eq 'hash=8a9e .*types=1$' "${build_dir}/remote-methods.txt" || {
  printf 'ERROR: CAP is missing throwCustomCryptoReason() metadata\n' >&2
  exit 1
}
method_count="$(wc -l < "${build_dir}/remote-methods.txt")"
[[ "${method_count}" -eq 27 ]] || {
  printf 'ERROR: expected 27 RMI methods in Class.cap, found %s\n' \
    "${method_count}" >&2
  exit 1
}
printf 'RMI_ARRAY_CAP:PASS cap=%s load_code=%s\n' \
  "${build_dir}/output/fixture.cap" "${build_dir}/rmi-fixture-load-code.bin"
