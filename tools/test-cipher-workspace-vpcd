#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

require_host_usb_access

"${repo_root}/tools/build-pc" --profile max_crypto
"${repo_root}/tools/build-cipher-lifecycle-probe"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log_file="${repo_root}/artifacts/logs/cipher-workspace-vpcd-${timestamp}.log"
flash_copy="${repo_root}/build/cipher-lifecycle-probe/cipher-workspace-vpcd-${timestamp}.bin"
"${repo_root}/tools/env" python3 \
  "${repo_root}/tests/integration/pc_vpcd_applet_test.py" \
  --emulator "${repo_root}/build/choupi-pc/choupi" \
  --cap-code "${repo_root}/build/cipher-lifecycle-probe/load-code.bin" \
  --rom-mask "${repo_root}/build/choupi-pc/flash" \
  --apdu-timeout 120 --applet-aid A00000015100020301 \
  --package-id 56 --passes 2 \
  --apdu 800E000000 --expect-apdu-response 019000 \
  --apdu 8012000000 --expect-apdu-response 019000 \
  --apdu 8013000000 --expect-apdu-response 019000 \
  --apdu 801400000D202122232425262728292A2B2C00 \
  --expect-apdu-response 019000 \
  --apdu 801100000F000102030405060708090A0B0C0D0E00 \
  --expect-apdu-response 019000 \
  --resume-apdu 800F000000 --expect-resume-apdu-response 449000 \
  --resume-apdu 8010000000 --expect-resume-apdu-response 019000 \
  --flash-copy "${flash_copy}" --log "${log_file}"

"${repo_root}/tools/env" python3 - "${flash_copy}" \
  "${repo_root}/build/cipher-lifecycle-probe/load-code.bin" <<'PY'
import sys
from pathlib import Path

flash_path, cap_code_path = map(Path, sys.argv[1:])
sentinels = {
    "pending CBC plaintext": bytes(range(15)),
    "transient AES key": bytes(range(0xB0, 0xC0)),
    "transient AES-CTR IV": bytes(range(0x60, 0x70)),
    "AES-CTR stream block": bytes.fromhex("ee83c1aeec49823d985bef0e2d400811"),
    "transient CTR input": bytes(range(0x20, 0x2D)),
}
cap_code = cap_code_path.read_bytes()
flash_image = flash_path.read_bytes()
for name, sentinel in sentinels.items():
    if sentinel in cap_code:
        raise SystemExit(f"TEST:FAIL {name} sentinel occurs in test CAP code")
    if sentinel in flash_image:
        raise SystemExit(f"TEST:FAIL {name} found in persisted flash image")
    print(f"TEST:PASS {name} absent from persisted flash sentinel_bytes={len(sentinel)}")
print(f"TEST:PASS persisted flash payload scan image_bytes={len(flash_image)} sentinels={len(sentinels)}")
PY
