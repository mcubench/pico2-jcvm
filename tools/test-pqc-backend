#!/usr/bin/env bash
# Host known-answer test of the ML-KEM/ML-DSA backend (choupi/src/pqc) against
# the committed NIST ACVP subset, under ASan and UBSan.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${repo_root}/build/tests/unit/pqc-backend"

"${repo_root}/tools/env" cmake -S "${repo_root}/tests/unit/pqc_backend" \
  -B "${build_dir}"
"${repo_root}/tools/env" cmake --build "${build_dir}" --target pqc_backend_test
python3 "${repo_root}/tests/unit/test_pqc_backend.py" \
  "${build_dir}/pqc_backend_test"
