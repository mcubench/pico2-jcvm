#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

[[ $# -ge 1 ]] || die "usage: ./tools/build arm|riscv [--profile PROFILE]"
arch_arg="$1"
shift
support_profile=baseline
debug_heap_gc=OFF
debug_persistent_gc=OFF
enable_object_deletion=OFF
debug_serial_wait_ms="${PICO2_DEBUG_SERIAL_WAIT_MS:-0}"
[[ "${debug_serial_wait_ms}" =~ ^(0|[1-9][0-9]*)$ && \
   ${#debug_serial_wait_ms} -le 6 ]] || \
  die "PICO2_DEBUG_SERIAL_WAIT_MS must be an integer from 0 to 120000"
(( debug_serial_wait_ms <= 120000 )) || \
  die "PICO2_DEBUG_SERIAL_WAIT_MS must be an integer from 0 to 120000"
if [[ "${PICO2_DEBUG_HEAP_GC:-0}" == 1 ]]; then
  debug_heap_gc=ON
elif [[ "${PICO2_DEBUG_HEAP_GC:-0}" != 0 ]]; then
  die "PICO2_DEBUG_HEAP_GC must be 0 or 1"
fi
if [[ "${PICO2_DEBUG_PERSISTENT_GC:-0}" == 1 ]]; then
  debug_persistent_gc=ON
elif [[ "${PICO2_DEBUG_PERSISTENT_GC:-0}" != 0 ]]; then
  die "PICO2_DEBUG_PERSISTENT_GC must be 0 or 1"
fi
if [[ "${PICO2_ENABLE_OBJECT_DELETION:-0}" == 1 ]]; then
  enable_object_deletion=ON
elif [[ "${PICO2_ENABLE_OBJECT_DELETION:-0}" != 0 ]]; then
  die "PICO2_ENABLE_OBJECT_DELETION must be 0 or 1"
fi
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ $# -ge 2 ]] || die "--profile requires a profile name"
      support_profile="$2"
      shift 2
      ;;
    *) die "usage: ./tools/build arm|riscv [--profile PROFILE]" ;;
  esac
done
case "${arch_arg}" in
  arm) arch=arm; platform=rp2350-arm-s ;;
  riscv) arch=riscv; platform=rp2350-riscv ;;
  *) die "unsupported architecture '${arch_arg}' (choose arm or riscv)" ;;
esac

require_sdk
"${repo_root}/tools/apply-tinyusb-event-budget"
require_command cmake
require_command ninja
require_command picotool
require_command sha256sum
require_command flock
mkdir -p "${repo_root}/build"
build_lock_file="${repo_root}/build/.tools-build.lock"
exec 9>"${build_lock_file}"
printf 'BUILD:LOCK waiting arch=%s profile=%s\n' "${arch}" "${support_profile}"
flock -x 9
printf 'BUILD:LOCK acquired arch=%s profile=%s\n' "${arch}" "${support_profile}"
build_jobs="${PICO_BUILD_JOBS:-2}"
[[ "${build_jobs}" =~ ^[1-9][0-9]*$ ]] || \
  die "PICO_BUILD_JOBS must be a positive integer"
cplc_source_id="$("${repo_root}/tools/cplc-source-id")"
printf 'BUILD:CPLC_SOURCE_ID value=%s\n' "${cplc_source_id}"
build_pc_dir="${repo_root}/build/choupi-pc"
support_dir="${repo_root}/build/javacard-support"
generation_manifest="${build_pc_dir}/generation.sha256"
api_source_manifest="${build_pc_dir}/api-sources.sha256"
support_config_manifest="${build_pc_dir}/support-config.sha256"
rommask_source_manifest="${build_pc_dir}/rommask-source.sha256"
generation_current=false
if [[ -s "${generation_manifest}" && -s "${api_source_manifest}" && \
      -s "${support_config_manifest}" && \
      -s "${rommask_source_manifest}" && \
      -s "${build_pc_dir}/flash" && -s "${build_pc_dir}/jni.hpp" && \
      -s "${support_dir}/javacard-rom-metadata.h" ]] && \
   (cd "${build_pc_dir}" && sha256sum --check generation.sha256 >/dev/null); then
  current_api_hash="$(find "${repo_root}/choupi/javacard-sdk/javacard-api/src" \
    -type f -name '*.java' -print0 | sort -z | xargs -0 sha256sum | \
    sha256sum | cut -d ' ' -f 1)"
  recorded_api_hash="$(awk '$2 == "javacard-api-sources" {print $1}' \
    "${api_source_manifest}")"
  current_support_hash="$( { sha256sum "${repo_root}/config/javacard-support.json"; printf 'profile=%s\n' "${support_profile}"; } | sha256sum | cut -d ' ' -f 1)"
  recorded_support_hash="$(awk '$2 == "support-selection" {print $1}' "${support_config_manifest}")"
  current_rommask_hash="$("${repo_root}/tools/rommask-source-hash")"
  recorded_rommask_hash="$(awk '$2 == "rommask-sources" {print $1}' "${rommask_source_manifest}")"
  [[ "${current_api_hash}" == "${recorded_api_hash}" && \
     "${current_support_hash}" == "${recorded_support_hash}" && \
     "${current_rommask_hash}" == "${recorded_rommask_hash}" ]] && generation_current=true
fi
if [[ "${generation_current}" != true ]]; then
  "${repo_root}/tools/build-pc" --profile "${support_profile}"
fi
python3 "${repo_root}/tools/javacard-support.py" \
  --config "${repo_root}/config/javacard-support.json" \
  --profile "${support_profile}" \
  --out-dir "${support_dir}"
build_dir="${repo_root}/build/${arch}"
linker_flags=""
arm_newlib_include=""
arm_newlib_dir=""
if [[ "${arch}" == arm ]]; then
  arm_newlib_dir="${tool_root}/usr/lib/arm-none-eabi/newlib/thumb/v8-m.main+fp/softfp"
  arm_newlib_include="${tool_root}/usr/include/newlib"
  [[ -f "${arm_newlib_dir}/libc.a" && -f "${arm_newlib_dir}/libg.a" ]] || \
    die "ARM Newlib libraries not found under ${arm_newlib_dir}"
  [[ -f "${arm_newlib_include}/assert.h" ]] || die "ARM Newlib headers not found under ${arm_newlib_include}"
  linker_flags="-L${arm_newlib_dir}"
fi
cmake -S "${repo_root}" -B "${build_dir}" -G Ninja \
  -U CMAKE_C_FLAGS -U CMAKE_CXX_FLAGS \
  -DPICO_SDK_PATH="${PICO_SDK_PATH}" \
  -DPICO_BOARD=pico2 \
  -DPICO_PLATFORM="${platform}" \
  -DPICO_FLASH_SIZE_BYTES=2097152 \
  -DCMAKE_BUILD_TYPE=Release \
  -DCHOUPI_CPLC_PERSONALIZER_EQUIPMENT_ID="${cplc_source_id}" \
  -DCHOUPI_DEBUG_HEAP_GC="${debug_heap_gc}" \
  -DCHOUPI_DEBUG_PERSISTENT_GC="${debug_persistent_gc}" \
  -DCHOUPI_ENABLE_OBJECT_DELETION="${enable_object_deletion}" \
  -DCHOUPI_DEBUG_SERIAL_WAIT_MS="${debug_serial_wait_ms}" \
  -DLOCAL_ARM_NEWLIB_INCLUDE="${arm_newlib_include}" \
  -DLOCAL_ARM_NEWLIB_LIBRARY_DIR="${arm_newlib_dir}" \
  -DCMAKE_EXE_LINKER_FLAGS="${linker_flags}"
generated_header="${repo_root}/build/choupi-pc/jni.hpp"
rom_image="${repo_root}/build/choupi-pc/flash"
generation_manifest="${repo_root}/build/choupi-pc/generation.sha256"
[[ -s "${generated_header}" && -s "${rom_image}" && -s "${generation_manifest}" ]] || \
  die "incomplete CHOUPI ROM-mask generation; run ./tools/build-pc"
(cd "${repo_root}/build/choupi-pc" && sha256sum --check generation.sha256) || \
  die "CHOUPI ROM-mask generation manifest does not match its artifacts"
mkdir -p "${build_dir}/choupi-generated"
cp "${generated_header}" "${build_dir}/choupi-generated/jni.hpp"
targets=(pico2_jcvm_smoke choupi_vm_core)
if [[ "${arch}" == arm ]]; then
  targets+=(pico2_choupi)
fi
cmake --build "${build_dir}" --target "${targets[@]}" --parallel "${build_jobs}"
image="${build_dir}/pico2_jcvm_smoke.uf2"
[[ -s "${image}" ]] || die "build did not produce ${image}"
picotool info -a "${image}"
printf 'BUILD:PASS arch=%s image=%s\n' "${arch}" "${image#${repo_root}/}"
if [[ "${arch}" == arm ]]; then
  choupi_image="${build_dir}/pico2_choupi.uf2"
  [[ -s "${choupi_image}" ]] || die "build did not produce ${choupi_image}"
  picotool info -a "${choupi_image}"
  python3 "${repo_root}/tools/check-firmware-flash-boundary" \
    "${build_dir}/pico2_choupi.elf.map"
  printf 'BUILD:PASS target=choupi image=%s\n' "${choupi_image#${repo_root}/}"
  if (( debug_serial_wait_ms > 0 )); then
    cp "${choupi_image}" \
      "${build_dir}/pico2_choupi_debug_serial_wait_${debug_serial_wait_ms}ms.uf2"
  fi
fi
provenance_file="${build_dir}/build-provenance.txt"
{
  printf 'architecture=%s\nprofile=%s\nserial_wait_ms=%s\ncplc_source_id=%s\n' \
    "${arch}" "${support_profile}" "${debug_serial_wait_ms}" \
    "${cplc_source_id}"
  printf 'debug_heap_gc=%s\ndebug_persistent_gc=%s\nobject_deletion=%s\n' \
    "${debug_heap_gc}" "${debug_persistent_gc}" "${enable_object_deletion}"
  if [[ "${arch}" == arm ]]; then
    if (( debug_serial_wait_ms > 0 )); then
      printf 'mode=diagnostic\nimage=%s\n' \
        "pico2_choupi_debug_serial_wait_${debug_serial_wait_ms}ms.uf2"
      sha256sum "${build_dir}/pico2_choupi_debug_serial_wait_${debug_serial_wait_ms}ms.uf2"
    elif [[ "${enable_object_deletion}" == ON || \
            "${debug_persistent_gc}" == ON || \
            "${debug_heap_gc}" == ON ]]; then
      printf 'mode=diagnostic\nimage=pico2_choupi.uf2\n'
      sha256sum "${build_dir}/pico2_choupi.uf2"
    else
      printf 'mode=normal\nimage=pico2_choupi.uf2\n'
      sha256sum "${build_dir}/pico2_choupi.uf2"
    fi
  else
    printf 'mode=shared-code-build-only\nimage=pico2_jcvm_smoke.uf2\n'
    sha256sum "${build_dir}/pico2_jcvm_smoke.uf2"
  fi
  sha256sum "${repo_root}/config/javacard-support.json"
} > "${provenance_file}"
if [[ "${arch}" == arm && "${debug_serial_wait_ms}" != 0 ]]; then
  cp "${provenance_file}" \
    "${build_dir}/pico2_choupi_debug_serial_wait_${debug_serial_wait_ms}ms.uf2.provenance.txt"
fi
printf 'BUILD:PROVENANCE path=%s serial_wait_ms=%s mode=%s object_deletion=%s debug_persistent_gc=%s\n' \
  "${provenance_file#${repo_root}/}" "${debug_serial_wait_ms}" \
  "$([[ "${debug_serial_wait_ms}" == 0 && "${enable_object_deletion}" == OFF && "${debug_persistent_gc}" == OFF && "${debug_heap_gc}" == OFF ]] && echo normal || echo diagnostic)" \
  "${enable_object_deletion}" "${debug_persistent_gc}"
