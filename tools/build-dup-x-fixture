#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_dir="${repo_root}/tests/fixtures/local/dup_x_fixture"
build_dir="${repo_root}/build/dup-x-fixture"
kit="$("${repo_root}/tools/fixture-path" toolchain.jc305)"
java8_home="${JAVA8_HOME:-${repo_root}/.local-toolchain/java8}"

[[ -x "${java8_home}/bin/javac" ]] || {
  printf 'ERROR: Java 8 compiler not found: %s\n' "${java8_home}" >&2
  exit 1
}
mkdir -p "${build_dir}/classes" "${build_dir}/output"

"${repo_root}/tools/env" "${java8_home}/bin/javac" \
  -source 1.7 -target 1.7 -Xlint:-options \
  -classpath "${kit}/lib/api_classic.jar" \
  -d "${build_dir}/classes" "${source_dir}/DupXApplet.java" \
  > "${build_dir}/compile.log" 2>&1

cat > "${build_dir}/build.xml" <<EOF_ANT
<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." default="build" name="DupXFixture">
  <property name="repo" location="${repo_root}"/>
  <property name="kit" location="\${repo}/.local-toolchain/java-card/provided/jc305u3_kit"/>
  <target name="build">
    <java classname="com.sun.javacard.converter.Main" fork="true"
          dir="\${basedir}/output" failonerror="true">
      <classpath><pathelement location="\${kit}/lib/tools.jar"/></classpath>
      <arg value="-i"/>
      <arg value="-classdir"/><arg value="\${basedir}/classes"/>
      <arg value="-exportpath"/><arg value="\${kit}/api_export_files"/>
      <arg value="-d"/><arg value="\${basedir}/output"/>
      <arg value="-out"/><arg value="JCA"/>
      <arg value="-applet"/><arg value="0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x00:0x60:0x01"/>
      <arg value="dupx.fixture.DupXApplet"/>
      <arg value="dupx.fixture"/>
      <arg value="0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x00:0x60"/>
      <arg value="1.0"/>
    </java>
  </target>
</project>
EOF_ANT

JAVA_HOME="${java8_home}" "${repo_root}/tools/env" ant \
  -f "${build_dir}/build.xml" > "${build_dir}/build.log" 2>&1

jca="${build_dir}/output/dupx/fixture/javacard/fixture.jca"
python3 - "${jca}" <<'PY'
import re
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text()
matrix = os.environ.get("DUP_X_MATRIX") == "1"
operand = int(os.environ.get("DUP_X_OPERAND", "18"), 0)
if not 0 <= operand <= 0xFF:
    raise SystemExit("DUP_X_OPERAND must be a byte value")
operand_m, operand_n = operand >> 4, operand & 0x0F
operand_is_legal = (
    1 <= operand_m <= 4
    and (operand_n == 0 or operand_m <= operand_n <= operand_m + 4)
)
assembly_operand = operand if operand_is_legal else 18

instructions = []
if matrix:
    for m in range(1, 5):
        for n in (0, *range(m, m + 5)):
            depth = m if n == 0 else n
            instructions.extend(f"sspush {value};" for value in range(1, depth + 1))
            instructions.append(f"dup_x {(m << 4) | n};")
            instructions.extend("pop;" for _ in range(depth + m))
    instructions.extend(("sspush 10;", "sreturn;"))
    stack_limit = 12
else:
    instructions = ["sspush 10;", "sspush 20;", f"dup_x {assembly_operand};",
                    "ssub;", "sadd;", "sreturn;"]
    stack_limit = 3
replacement_body = "\n".join(
    [f"\t\t\t.stack {stack_limit};", "\t\t\t.locals 0;", ""]
    + [f"\t\t\t\tL{index}: {instruction}" if index == 0
       else f"\t\t\t\t\t{instruction}"
       for index, instruction in enumerate(instructions)]
)
pattern = re.compile(
    r"(?P<header>\s*\.method\s+[^\n]*dupXProbe\(\)S(?:\s+\d+)?\s*\{)"
    r"(?P<body>.*?)"
    r"(?P<close>^\s*\})",
    re.MULTILINE | re.DOTALL,
)
updated, replacements = pattern.subn(
    lambda match: match.group("header") + replacement_body + match.group("close"),
    text,
)
if replacements != 1:
    raise SystemExit(f"expected one dupXProbe JCA method, found {replacements}")
path.write_text(updated)
if not matrix and f"dup_x {assembly_operand};" not in updated:
    raise SystemExit("assembled dup_x operand was not written")

invalid_pattern = re.compile(
    r"(?P<header>\s*\.method\s+[^\n]*invalidDupXProbe\(\)S(?:\s+\d+)?\s*\{)"
    r"(?P<body>.*?)"
    r"(?P<close>^\s*\})",
    re.MULTILINE | re.DOTALL,
)
invalid_body = "\n".join((
    "\t\t\t.stack 3;",
    "\t\t\t.locals 0;",
    "",
    "\t\t\t\tL0: sspush 30;",
    "\t\t\t\t\tsspush 40;",
    "\t\t\t\t\tdup_x 18;",
    "\t\t\t\t\tssub;",
    "\t\t\t\t\tsadd;",
    "\t\t\t\t\tsreturn;",
))
updated, invalid_replacements = invalid_pattern.subn(
    lambda match: match.group("header") + invalid_body + match.group("close"),
    updated,
)
if invalid_replacements != 1:
    raise SystemExit(
        f"expected one invalidDupXProbe JCA method, found {invalid_replacements}"
    )
path.write_text(updated)
PY

"${repo_root}/tools/env" java \
  -cp "${kit}/lib/tools.jar" com.sun.javacard.jcasm.cap.Main \
  -nobanner -o "${build_dir}/output/fixture.cap" "${jca}" \
  > "${build_dir}/capgen.log" 2>&1

python3 - "${build_dir}/output/fixture.cap" \
  "${build_dir}/dup-x-fixture-load-code.bin" <<'PY'
import os
import sys
import tempfile
from zipfile import ZIP_DEFLATED, ZipFile

source, target = sys.argv[1:]
operand = int(os.environ.get("DUP_X_OPERAND", "18"), 0)
matrix = os.environ.get("DUP_X_MATRIX") == "1"
operand_m, operand_n = operand >> 4, operand & 0x0F
operand_is_legal = (
    1 <= operand_m <= 4
    and (operand_n == 0 or operand_m <= operand_n <= operand_m + 4)
)
if not matrix and not operand_is_legal:
    needle = bytes.fromhex("11 00 0a 11 00 14 3f 12 43 41 78")
    with ZipFile(source, "r") as cap:
        entries = [(entry, cap.read(entry.filename)) for entry in cap.infolist()]
    matches = 0
    updated_entries = []
    for entry, content in entries:
        if entry.filename.endswith("/Method.cap"):
            matches += content.count(needle)
            if content.count(needle) == 1:
                content = content.replace(
                    needle, needle[:7] + bytes([operand]) + needle[8:], 1)
        updated_entries.append((entry, content))
    if matches != 1:
        raise SystemExit(f"expected one placeholder dup_x instruction, found {matches}")
    fd, temporary = tempfile.mkstemp(dir=os.path.dirname(source), suffix=".cap")
    os.close(fd)
    try:
        with ZipFile(temporary, "w", ZIP_DEFLATED) as cap:
            for entry, content in updated_entries:
                cap.writestr(entry, content)
        os.replace(temporary, source)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
if os.environ.get("DUP_X_INVALID_RUNTIME") == "1":
    needle = bytes.fromhex("11 00 1e 11 00 28 3f 12 43 41 78")
    with ZipFile(source, "r") as cap:
        entries = [(entry, cap.read(entry.filename)) for entry in cap.infolist()]
    matches = 0
    updated_entries = []
    for entry, content in entries:
        if entry.filename.endswith("/Method.cap"):
            matches += content.count(needle)
            if content.count(needle) == 1:
                content = content.replace(
                    needle, needle[:7] + bytes([0x17]) + needle[8:], 1)
        updated_entries.append((entry, content))
    if matches != 1:
        raise SystemExit(
            f"expected one invalid-runtime dup_x placeholder, found {matches}"
        )
    fd, temporary = tempfile.mkstemp(dir=os.path.dirname(source), suffix=".cap")
    os.close(fd)
    try:
        with ZipFile(temporary, "w", ZIP_DEFLATED) as cap:
            for entry, content in updated_entries:
                cap.writestr(entry, content)
        os.replace(temporary, source)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
components = ("Header", "Directory", "Applet", "Import", "ConstantPool",
              "Class", "Method", "StaticField", "RefLocation", "Descriptor")
with ZipFile(source) as cap, open(target, "wb") as output:
    names = set(cap.namelist())
    prefix = "dupx/fixture/javacard/"
    for component in components:
        name = f"{prefix}{component}.cap"
        if name not in names:
            raise SystemExit(f"CAP is missing required component {name}")
        output.write(cap.read(name))
label = "matrix=24" if matrix else f"operand=0x{operand:02X}"
if os.environ.get("DUP_X_INVALID_RUNTIME") == "1":
    label += " invalid_runtime=0x17"
print(f"DUP_X_CAP:PASS {label} cap={source} load_code={target}")
PY
