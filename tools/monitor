#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

seconds=8
while [[ $# -gt 0 ]]; do
  case "$1" in
    --seconds)
      [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || die "--seconds requires a positive integer"
      seconds="$2"
      shift 2
      ;;
    *) die "usage: ./tools/monitor [--seconds N]" ;;
  esac
done

require_host_usb_access

# RP2350 USB CDC can appear well after picotool reports its reboot complete,
# especially through a VM USB passthrough. Keep this wait bounded but allow
# 30 seconds for enumeration before declaring the monitor unavailable.
device=""
for _ in $(seq 1 120); do
  for candidate in /dev/serial/by-id/* /dev/ttyACM*; do
    [[ -e "$candidate" ]] || continue
    device="$candidate"
    break 2
  done
  sleep 0.25
done
[[ -n "$device" ]] || die "no USB serial device found"
require_command stty
ready=0
for _ in $(seq 1 20); do
  # Opening a stale USB ACM node can block in the kernel/VM after reset. Bound
  # every attempt so the retry loop remains finite during USB re-enumeration.
  if timeout --foreground --kill-after=1s 1s \
      stty -F "$device" 115200 raw -echo 2>/dev/null; then
    ready=1
    break
  fi
  sleep 0.25
done
(( ready == 1 )) || die "cannot configure serial device ${device}"
printf 'MONITOR:START device=%s seconds=%s\n' "$device" "$seconds"
set +e
timeout --signal=TERM --kill-after=2s "${seconds}s" cat "$device"
status=$?
set -e
if (( status == 124 )); then
  exit 0
fi
exit "$status"
