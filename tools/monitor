#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

seconds=8
serial=""
usb_path=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --seconds)
      [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || die "--seconds requires a positive integer"
      seconds="$2"
      shift 2
      ;;
    --serial)
      [[ $# -ge 2 && -z "$serial" && "$2" =~ ^[A-Fa-f0-9]{8,32}$ ]] || die "--serial requires an 8..32 character hexadecimal Pico serial"
      serial="$2"
      shift 2
      ;;
    --usb-path)
      [[ $# -ge 2 && -z "$usb_path" && "$2" =~ ^[0-9]+-[0-9]+([.][0-9]+)*$ ]] || die "--usb-path requires a USB topology path such as 1-3 or 1-3.2"
      usb_path="$2"
      shift 2
      ;;
    --help|-h)
      printf 'usage: ./tools/monitor [--serial SERIAL | --usb-path PATH] [--seconds N]\n'
      exit 0
      ;;
    *) die "usage: ./tools/monitor [--serial SERIAL | --usb-path PATH] [--seconds N]" ;;
  esac
done
[[ -z "$serial" || -z "$usb_path" ]] || die "choose either --serial or --usb-path"

require_host_usb_access

# RP2350 USB CDC can appear well after picotool reports its reboot complete,
# especially through a VM USB passthrough. Keep this wait bounded but allow
# 30 seconds for enumeration before declaring the monitor unavailable.
device=""
for _ in $(seq 1 120); do
  candidates=()
  shopt -s nullglob
  if [[ -n "$usb_path" ]]; then
    for tty in /sys/class/tty/ttyACM*; do
      sysfs_tty="$(readlink -f "$tty")"
      if [[ "$sysfs_tty" == *"/${usb_path}/${usb_path}:1.0/tty/"* ]]; then
        candidates+=("/dev/${tty##*/}")
      fi
    done
  elif [[ -n "$serial" ]]; then
    all_candidates=(/dev/serial/by-id/*)
    for candidate in "${all_candidates[@]}"; do
      candidate_upper="${candidate^^}"
      if [[ "$candidate_upper" == *"${serial^^}"* &&
            "$candidate_upper" == *-IF00 ]]; then
        candidates+=("$candidate")
      fi
    done
  else
    candidates=(/dev/serial/by-id/*)
    if ((${#candidates[@]} == 0)); then
      candidates=(/dev/ttyACM*)
    fi
  fi
  shopt -u nullglob
  if [[ -z "$serial" && -z "$usb_path" && ${#candidates[@]} -gt 1 ]]; then
    die "multiple USB serial devices found; select one with --serial or --usb-path"
  fi
  for candidate in "${candidates[@]}"; do
    [[ -e "$candidate" ]] || continue
    device="$candidate"
    break 2
  done
  sleep 0.25
done
[[ -n "$device" ]] || die "no USB serial device found"
require_command stty
ready=0
for _ in $(seq 1 20); do
  # Opening a stale USB ACM node can block in the kernel/VM after reset. Bound
  # every attempt so the retry loop remains finite during USB re-enumeration.
  if timeout --foreground --kill-after=1s 1s \
      stty -F "$device" 115200 raw -echo 2>/dev/null; then
    ready=1
    break
  fi
  sleep 0.25
done
(( ready == 1 )) || die "cannot configure serial device ${device}"
printf 'MONITOR:START device=%s seconds=%s\n' "$device" "$seconds"
set +e
timeout --signal=TERM --kill-after=2s "${seconds}s" cat "$device"
status=$?
set -e
if (( status == 124 )); then
  exit 0
fi
exit "$status"
