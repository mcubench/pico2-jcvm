#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

[[ $# -eq 0 ]] || die "usage: PICO2_HOST_USB_ACCESS=1 ./tools/test-gp-get-data-vpcd"
require_host_usb_access
require_command timeout
require_command grep
require_command stdbuf
require_command pcsc_scan

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
out_dir="${repo_root}/artifacts/results/gp-get-data-vpcd-${timestamp}"
mkdir -p "${out_dir}"
"${repo_root}/tools/build-pc" > "${out_dir}/build-pc.log" 2>&1

reader="Virtual PCD 00 00"
endpoint="127.0.0.1:35963"
emulator="${repo_root}/build/choupi-pc/choupi"
rom_mask="${repo_root}/build/choupi-pc/flash"
empty_flash="${repo_root}/build/algtest-v182-empty-flash.bin"
load_code="${repo_root}/build/algtest-v182-load-code.bin"
for input in "${emulator}" "${rom_mask}" "${empty_flash}" "${load_code}"; do
  [[ -s "${input}" ]] || die "required input is missing: ${input}"
done

flash_image="${out_dir}/flash.bin"
cp "${empty_flash}" "${flash_image}"

reader_found=false
for attempt in 1 2 3; do
  inventory_log="${out_dir}/reader-inventory-${attempt}.log"
  timeout --signal=TERM --kill-after=2s 8s \
    stdbuf -oL -eL "${repo_root}/tools/env" pcsc_scan -r \
    > "${inventory_log}" 2>&1 || true
  if grep -Fq "${reader}" "${inventory_log}"; then
    reader_found=true
    break
  fi
  sleep 1
done
if [[ "${reader_found}" != true ]]; then
  for attempt in 1 2 3; do cat "${out_dir}/reader-inventory-${attempt}.log" >&2; done
  die "configured VPCD reader was not found after 3 bounded PC/SC scans"
fi

"${repo_root}/tools/env" "${emulator}" -m "${flash_image}" -s \
  --vpcd "${endpoint}" --vpcd-idle-timeout 30 \
  --applet-aid 4A43416C675465737431 --package-id 63 \
  --cap-code "${load_code}" --rom-mask "${rom_mask}" \
  > "${out_dir}/emulator.log" 2>&1 &
emulator_pid=$!
cleanup() {
  if kill -0 "${emulator_pid}" 2>/dev/null; then
    kill -TERM "${emulator_pid}" 2>/dev/null || true
    wait "${emulator_pid}" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

sleep 1
if ! timeout --signal=TERM --kill-after=2s 8s \
    "${repo_root}/tools/env" java "${repo_root}/tools/VpcdPresenceProbe.java" \
    "${reader}" 5000 --require-present > "${out_dir}/reader-ready.log" 2>&1; then
  cat "${out_dir}/emulator.log" >&2
  cat "${out_dir}/reader-ready.log" >&2
  die "emulator did not make the clean VPCD card present"
fi

PICO2_HOST_USB_ACCESS=1 "${repo_root}/tools/probe-gp-get-data" "${reader}" \
  | tee "${out_dir}/apdu-probe.log"
printf 'GP_GET_DATA_VPCD:PASS reader=%s artifacts=%s\n' \
  "${reader}" "${out_dir#${repo_root}/}"
