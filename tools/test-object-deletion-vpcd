#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"
require_host_usb_access

iterations="${1:-8}"
mode="${2:-byte-array}"
key_bits="${3:-512}"
apdu_timeout="${PICO2_VPCD_APDU_TIMEOUT:-20}"
if ! [[ "${iterations}" =~ ^[1-9][0-9]*$ ]] || \
  ((iterations < 1 || iterations > 512)); then
  die "usage: $0 [iterations 1..512] [byte-array|rsa-public|rsa-live-static|rsa-batch] [rsa-bits for rsa-public]"
fi
if ! [[ "${apdu_timeout}" =~ ^[1-9][0-9]{0,3}$ ]]; then
  die "PICO2_VPCD_APDU_TIMEOUT must be an integer from 1 to 9999 seconds"
fi
[[ "${mode}" == "byte-array" || "${mode}" == "rsa-public" || \
   "${mode}" == "rsa-live-static" || "${mode}" == "rsa-batch" ]] || \
  die "usage: $0 [iterations 1..512] [byte-array|rsa-public|rsa-live-static|rsa-batch] [rsa-bits for rsa-public]"
[[ "${key_bits}" == 512 || "${key_bits}" == 1024 || \
   "${key_bits}" == 2048 || "${key_bits}" == 4096 ]] || \
  die "RSA key size must be 512, 1024, 2048, or 4096 bits"
if [[ "${mode}" != "rsa-public" && "${key_bits}" != 512 ]]; then
  die "RSA key size selection is available only in rsa-public mode"
fi
rsa_size_code=0
case "${key_bits}" in
  1024) rsa_size_code=1 ;;
  2048) rsa_size_code=2 ;;
  4096) rsa_size_code=3 ;;
esac

"${repo_root}/tools/build-pc" --profile max_crypto
"${repo_root}/tools/build-persistent-reclaimer-probe"

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
flash_copy="${repo_root}/build/persistent-reclaimer-probe/vpcd-object-deletion-${stamp}.bin"
log="${repo_root}/artifacts/logs/object-deletion-vpcd-${stamp}.log"
mkdir -p "${repo_root}/artifacts/logs"

probe_args=(
  --apdu-timeout "${apdu_timeout}"
  --emulator "${repo_root}/build/choupi-pc/choupi"
  --cap-code "${repo_root}/build/persistent-reclaimer-probe/load-code.bin"
  --rom-mask "${repo_root}/build/choupi-pc/flash"
  --applet-aid A000000062030201 --package-id 57 --passes 1
  --flash-copy "${flash_copy}" --log "${log}"
)
if [[ "${mode}" == "rsa-batch" ]]; then
  for ((iteration = 0; iteration < iterations; ++iteration)); do
    probe_args+=(
      --apdu 0000070000 --expect-apdu-response 379000
    )
  done
  probe_args+=(
    --apdu 0000080000 --expect-apdu-response 019000
    --apdu 00000D0000 --expect-apdu-response 009000
  )
else
  for ((iteration = 0; iteration < iterations; ++iteration)); do
    if [[ "${mode}" == "rsa-public" ]]; then
      probe_args+=(
        --apdu "0000070${rsa_size_code}00" --expect-apdu-response 379000
        --apdu 0000080000 --expect-apdu-response 019000
        --apdu 0000080000 --expect-apdu-response 019000
      )
    elif [[ "${mode}" == "rsa-live-static" ]]; then
      probe_args+=(
        --apdu 0000090000 --expect-apdu-response 379000
        --apdu 00000A0000 --expect-apdu-response 019000
        --apdu 00000C0000 --expect-apdu-response 379000
        --apdu 00000B0000 --expect-apdu-response 019000
        --apdu 00000B0000 --expect-apdu-response 019000
      )
    else
      probe_args+=(
        --apdu 0000010000 --expect-apdu-response 2A9000
        --apdu 0000060000 --expect-apdu-response 019000
      )
    fi
  done
fi
if [[ "${mode}" == "rsa-batch" ]]; then
  total_records=$((iterations * 10))
  deletion_calls=$((total_records / 8 + 1))
  # APDU 000008 above starts the deletion request; APDU 00000D above is
  # already the first continuation. Use status-only APDUs for any remaining
  # batches so the harness does not create a fresh empty deletion request.
  for ((call = 2; call < deletion_calls; ++call)); do
    probe_args+=(--apdu 00000D0000 --expect-apdu-response 009000)
  done
fi
probe_args+=(--apdu 0000050000 --expect-apdu-response 009000)

PICO2_HOST_USB_ACCESS=1 PICO2_TEST_OBJECT_DELETION=1 \
  "${repo_root}/tools/env" python3 \
  "${repo_root}/tests/integration/pc_vpcd_applet_test.py" \
  "${probe_args[@]}"

grep -Eq '^OBJECT_DELETION: .*erased_package=0 ' "${log}" || \
  die "unexpected package-static erase in this owner-only fixture; see ${log}"
awk '
  /^OBJECT_DELETION: package=/ {
    match($0, /erased_applet=[0-9]+/)
    applet = substr($0, RSTART + 14, RLENGTH - 14) + 0
    match($0, /erased_package=[0-9]+/)
    package = substr($0, RSTART + 15, RLENGTH - 15) + 0
    if (applet + package > 8) failed = 1
  }
  END { if (failed) exit 1 }
' "${log}" || die "a physical-equivalent batch exceeded eight records; see ${log}"
call_count="$(grep -c '^OBJECT_DELETION: package=' "${log}" || true)"
reclaim_count="$(grep -Ec \
  '^OBJECT_DELETION: package=.*applet_result=0 package_result=0 erased_applet=[1-9][0-9]* ' \
  "${log}" || true)"
expected_calls="${iterations}"
if [[ "${mode}" == "rsa-public" ]]; then
  expected_calls=$((iterations * 2))
fi
if [[ "${mode}" == "rsa-live-static" ]]; then
  expected_calls=$((iterations * 3))
elif [[ "${mode}" == "rsa-batch" ]]; then
  expected_calls=$deletion_calls
fi
[[ "${call_count}" -eq "${expected_calls}" ]] || \
  die "expected ${expected_calls} collector calls, got ${call_count}; see ${log}"
expected_reclaims="${iterations}"
if [[ "${mode}" == "rsa-batch" ]]; then
  expected_reclaims=$((total_records % 8 == 0 ? 0 : 1))
fi
[[ "${reclaim_count}" -eq "${expected_reclaims}" ]] || \
  die "expected ${expected_reclaims} completed request-triggered reclamations, got ${reclaim_count}; see ${log}"
erased_total="$(grep '^OBJECT_DELETION: package=' "${log}" | \
  sed -n 's/.* erased_applet=\([0-9][0-9]*\) .*/\1/p' | \
  awk '{ total += $1 } END { print total + 0 }')"
if [[ "${mode}" == "byte-array" ]]; then
  [[ "${erased_total}" -eq "${iterations}" ]] || \
    die "expected exactly one applet-owned tag erased per byte-array cycle (${iterations}), got ${erased_total}; see ${log}"
elif [[ "${mode}" == "rsa-batch" ]]; then
  expected_erased=$((iterations * 10))
  [[ "${erased_total}" -eq "${expected_erased}" ]] || \
    die "expected ${expected_erased} applet-owned tags erased after ${iterations} RSA replacements, got ${erased_total}; see ${log}"
elif [[ "${mode}" == "rsa-public" ]]; then
  [[ "${erased_total}" -eq $((iterations * 10)) ]] || \
    die "expected ten applet-owned records per RSA replacement, got ${erased_total}; see ${log}"
else
  awk -v expected="${iterations}" '
    /^OBJECT_DELETION: package=/ {
      match($0, /erased_applet=[0-9]+/)
      value = substr($0, RSTART + 14, RLENGTH - 14) + 0
      match($0, /static_roots=[0-9]+/)
      static_value = substr($0, RSTART + 13, RLENGTH - 13) + 0
      calls++
      slot = (calls - 1) % 3
      if (slot == 0) {
        if (value != 0 || static_value != 1) failed = 1
      } else {
        if (value == 0 || static_value != 0 || value > 8) failed = 1
      }
      total += value
      match($0, /erased_package=[0-9]+/)
      package_value = substr($0, RSTART + 15, RLENGTH - 15) + 0
      if (package_value != 0) failed = 1
      if (value > 8) failed = 1
    }
    END {
      if (calls != expected * 3 || total != expected * 10 || failed) exit 1
      printf "OBJECT_DELETION_LIVE_STATIC:PASS requests=%d records_per_cycle=%d\n", calls, expected * 10
    }
  ' "${log}" || die "live RSA static root was not consistently preserved then reclaimed; see ${log}"
fi
(( erased_total > 0 )) || die "deletion requests erased no applet-owned records; see ${log}"
size_label=""
if [[ "${mode}" == "rsa-public" ]]; then
  size_label=" rsa_bits=${key_bits}"
fi
printf 'OBJECT_DELETION_VPCD:PASS mode=%s%s requests=%s erased_applet_tags=%s log=%s\n' \
  "${mode}" "${size_label}" "${call_count}" "${erased_total}" \
  "${log#${repo_root}/}"
