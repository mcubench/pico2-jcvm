#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${repo_root}/tools/common.sh"
require_host_usb_access
"${repo_root}/tools/build-pc" --profile max_crypto
"${repo_root}/tools/build-hmac-probe"
mkdir -p "${repo_root}/build/tests/hmac" "${repo_root}/artifacts/logs"
: > "${repo_root}/build/tests/hmac/hmac-empty-flash.bin"
"${repo_root}/tools/env" python3 \
  "${repo_root}/tests/integration/test_hmac_vpcd.py"
