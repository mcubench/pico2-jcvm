#!/usr/bin/env bash
set -euo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

if (( EUID != 0 )); then
  printf 'This helper must be run through its sudoers entry.\n' >&2
  exit 1
fi
if (( $# != 0 )); then
  printf 'This helper accepts no arguments.\n' >&2
  exit 2
fi

matches=()
for device in /sys/bus/usb/devices/*; do
  [[ -r "${device}/idVendor" && -r "${device}/idProduct" &&
     -r "${device}/busnum" && -r "${device}/devnum" ]] || continue
  [[ "$(<"${device}/idVendor")" == 2e8a &&
     "$(<"${device}/idProduct")" == 0009 ]] || continue
  matches+=("${device}")
done

if (( ${#matches[@]} != 1 )); then
  printf 'Expected exactly one Pico 2 CHOUPI CCID (2e8a:0009); found %s.\n' \
    "${#matches[@]}" >&2
  exit 1
fi

bus_text="$(<"${matches[0]}/busnum")"
device_text="$(<"${matches[0]}/devnum")"
if [[ ! "${bus_text}" =~ ^[0-9]{1,3}$ ||
      ! "${device_text}" =~ ^[0-9]{1,3}$ ]]; then
  printf 'Invalid USB bus/device numbers in sysfs.\n' >&2
  exit 1
fi
bus_number=$((10#${bus_text}))
device_number=$((10#${device_text}))
if (( bus_number < 1 || bus_number > 255 ||
      device_number < 1 || device_number > 255 )); then
  printf 'USB bus/device number is out of range.\n' >&2
  exit 1
fi

printf -v usb_node '/dev/bus/usb/%03d/%03d' \
  "${bus_number}" "${device_number}"
if [[ ! -c "${usb_node}" ]]; then
  printf 'Pico USB node is missing: %s\n' "${usb_node}" >&2
  exit 1
fi
if ! getent passwd pcscd >/dev/null; then
  printf 'The pcscd service account does not exist.\n' >&2
  exit 1
fi

/usr/bin/setfacl -m u:pcscd:rw "${usb_node}"
/usr/bin/systemctl restart pcscd.service
printf 'PCSC:ACCESS_GRANTED node=%s service=pcscd.service\n' "${usb_node}"
