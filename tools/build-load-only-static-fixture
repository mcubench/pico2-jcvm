#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_root="${repo_root}/tests/fixtures/local/load_only_static_fixture"
build_dir="${repo_root}/build/load-only-static-fixture"
kit="$("${repo_root}/tools/fixture-path" toolchain.jc305)"
java8_home="${JAVA8_HOME:-${repo_root}/.local-toolchain/java8}"

[[ -x "${java8_home}/bin/javac" ]] || {
  printf 'ERROR: Java 8 compiler not found: %s\n' "${java8_home}" >&2
  exit 1
}
rm -rf "${build_dir}"
mkdir -p "${build_dir}"/{tables-classes,tables-cap,tables-exp,client-classes,client-cap}
converter=(env "JAVA_HOME=${java8_home}" "PATH=${java8_home}/bin:${PATH}"
  "${repo_root}/tools/env" java "-Duser.home=${build_dir}" "-Djc.home=${kit}"
  -cp "${kit}/lib/tools.jar" com.sun.javacard.converter.Main -nobanner
  -exportpath "${kit}/api_export_files:${build_dir}/tables-exp")
javac=("${repo_root}/tools/env" "${java8_home}/bin/javac" -source 1.7 -target 1.7
  -Xlint:-options)

"${javac[@]}" -classpath "${kit}/lib/api_classic.jar" \
  -d "${build_dir}/tables-classes" "${source_root}/tables"/*.java
for output in CAP EXP; do
  target="${build_dir}/tables-cap"
  [[ "${output}" == EXP ]] && target="${build_dir}/tables-exp"
  "${converter[@]}" -classdir "${build_dir}/tables-classes" -d "${target}" \
    -out "${output}" lostatic.tables 0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x0A 1.0
done
# Add array_init {byte, 3, 11 22 33} for the first reference static (TABLE),
# which the converter refuses to emit for a library package.
python3 - "${build_dir}/tables-cap/lostatic/tables/javacard/tables.cap" <<'PY'
import shutil
import sys
from zipfile import ZIP_DEFLATED, ZipFile

path = sys.argv[1]
folder = "lostatic/tables/javacard/"
with ZipFile(path) as cap:
    entries = [(info, cap.read(info.filename)) for info in cap.infolist()]
data = {info.filename: content for info, content in entries}
static = bytearray(data[folder + "StaticField.cap"])
if static[5:9] != bytes.fromhex("00010000"):
    raise SystemExit("expected one reference static and no array_init")
record = bytes.fromhex("030003112233")
static[7:9] = (1).to_bytes(2, "big")
static[9:9] = record
static[1:3] = (len(static) - 3).to_bytes(2, "big")
directory = bytearray(data[folder + "Directory.cap"])
sizes = 3
static_size = sizes + 7 * 2  # StaticField is component 8 of the CAP 2.1 list
directory[static_size:static_size + 2] = (len(static) - 3).to_bytes(2, "big")
info_offset = sizes + 11 * 2  # image_size, array_init_count, array_init_size
directory[info_offset + 2:info_offset + 6] = bytes.fromhex("00010003")
data[folder + "StaticField.cap"] = bytes(static)
data[folder + "Directory.cap"] = bytes(directory)
with ZipFile(path + ".tmp", "w", ZIP_DEFLATED) as out:
    for info, _ in entries:
        out.writestr(info, data[info.filename])
shutil.move(path + ".tmp", path)
PY
"${javac[@]}" -classpath "${kit}/lib/api_classic.jar:${build_dir}/tables-classes" \
  -d "${build_dir}/client-classes" "${source_root}/client"/*.java
"${converter[@]}" -classdir "${build_dir}/client-classes" \
  -d "${build_dir}/client-cap" -out CAP \
  -applet 0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x0B:0x01 \
  lostatic.client.ClientApplet lostatic.client \
  0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x0B 1.0
printf 'CAP:PASS tables=%s client=%s\n' \
  "$(find "${build_dir}/tables-cap" -name '*.cap')" \
  "$(find "${build_dir}/client-cap" -name '*.cap')"
