& {
# ---- choose the test --------------------------------------------------------
# 'all'       = menu 2 -> PERFORMANCE TEST -> 1 All algorithms (5-8 hours).
#               Runs fully from the command line: -op ALG_PERFORMANCE_STATIC.
# 'symmetric' = menu 2 -> PERFORMANCE TEST -> 2 Only algorithms WITHOUT asymmetric
#               cryptography (1-3 hours). The 1.8.5 client has no command-line
#               switch for this choice, so the block answers the two menu prompts
#               itself after it sees each one in the client log.
# 'pqc'       = ALG_SUPPORT_BASIC with the JCAlgTest 1.8.6/jc32 CAP and client
#               (JC 3.2 ML-KEM/ML-DSA rows; 30+ minutes, on-card RSA generation dominates). Installs applet-jc32.cap
#               instead of the unchanged 1.8.5/jc305 applet.cap.
# 'pqcperf'   = menu 2 -> PERFORMANCE TEST -> 4 Only post-quantum algorithms, with
#               the 1.8.6/jc32 CAP and client (ML-KEM/ML-DSA keygen, encaps/decaps,
#               sign/verify; 5-10 minutes). Answers the prompts like 'symmetric'.
# 'jcmathlib' = loads jcmathlib-unit_tests.cap with the descriptor-preserving
#               loader and replays the BnShiftRight APDU (seconds).
# run-all.ps1 sets PICO2_RUN_MODE; when it is unset, the line below decides.
$mode = if ($env:PICO2_RUN_MODE) { $env:PICO2_RUN_MODE } else { 'all' }
$reader = 'Pico2 JCVM CCID 0'
# -----------------------------------------------------------------------------
if (@('all', 'symmetric', 'pqc', 'pqcperf', 'jcmathlib') -notcontains $mode) { throw "mode must be 'all', 'symmetric', 'pqc', 'pqcperf' or 'jcmathlib'" }
$root = (Get-Location).Path
$image = Join-Path $root 'firmware\@UF2_NAME@'
$expected = '@UF2_SHA@'
$gp = Join-Path $root 'tools\gp.jar'
$client = Join-Path $root 'tools\AlgTestJClient_v1.8.5.jar'
$cap = Join-Path $root 'applet.cap'
if ($mode -like 'pqc*') { $client = Join-Path $root 'tools\AlgTestJClient_v1.8.6_jc32.jar'; $cap = Join-Path $root 'applet-jc32.cap' }
if ($mode -eq 'jcmathlib') { $cap = Join-Path $root 'jcmathlib-unit_tests.cap' }
$capture = Join-Path $root 'tools\capture-object-deletion.ps1'
$health = Join-Path $root 'tools\health.ps1'
function Save-Health([string]$Name) {
  & powershell -NoProfile -ExecutionPolicy Bypass -File $health -Reader $reader -Gp $gp -OutFile (Join-Path $run "$Name.txt") | Out-Null
}
foreach ($f in @($image, $gp, $client, $cap, $capture, $health)) { if (-not (Test-Path $f)) { throw "Missing $f; run this block in the extracted package directory" } }
$run = Join-Path $root ('results\' + $mode + '_' + (Get-Date -Format 'yyyyMMdd_HHmmss'))
New-Item -ItemType Directory -Force -Path $run | Out-Null
function Invoke-Gp([string]$Name, [string]$Arguments) {
  $p = Start-Process -FilePath 'java' -ArgumentList ("-jar `"$gp`" --reader `"$reader`" " + $Arguments) -NoNewWindow -Wait -PassThru -RedirectStandardOutput (Join-Path $run "$Name.txt") -RedirectStandardError (Join-Path $run "$Name.err.txt")
  return $p.ExitCode
}

# 1. Verify and flash the empty-card image (Pico 2 must be in BOOTSEL mode).
$actual = (Get-FileHash $image -Algorithm SHA256).Hash.ToLowerInvariant()
if ($actual -ne $expected) { throw "Firmware hash mismatch: $actual" }
$volume = Get-Volume | Where-Object FileSystemLabel -eq 'rp2350' | Select-Object -First 1
if (-not $volume -or -not $volume.DriveLetter) { throw 'rp2350 BOOTSEL drive not found: hold BOOTSEL while connecting the Pico 2' }
Copy-Item $image -Destination ($volume.DriveLetter + ':\')
Write-Host "FLASHED $image to $($volume.DriveLetter):"

# 2. Wait for the CCID reader, then identify the board.
$deadline = (Get-Date).AddSeconds(120)
do { Start-Sleep -Seconds 3; $rc = Invoke-Gp 'gp-list-before' '--list' } until ($rc -eq 0 -or (Get-Date) -gt $deadline)
if ($rc -ne 0) { throw "Reader '$reader' not usable after flashing; see $run\gp-list-before*.txt" }
$usb = Get-CimInstance Win32_PnPEntity | Where-Object { $_.PNPDeviceID -match '^USB\\VID_2E8A&PID_0009\\([0-9A-F]{16})$' } | Select-Object -First 1
$chip = if ($usb -and $usb.PNPDeviceID -match '\\([0-9A-F]{16})$') { $Matches[1] } else { 'unknown' }
$com = Get-CimInstance Win32_PnPEntity | Where-Object { $_.PNPDeviceID -match 'VID_2E8A&PID_0009' -and $_.Name -match '\((COM\d+)\)' } | Select-Object -First 1
if (-not $com -or $com.Name -notmatch '\((COM\d+)\)') { throw 'Pico 2 serial (COM) port not found' }
$port = $Matches[1]
Write-Host "BOARD chip_id=$chip serial_port=$port reader=$reader"

# 3. Start the serial capture (it stops when the client finishes).
$stop = Join-Path $run 'serial.stop'
$cap_proc = Start-Process -FilePath 'powershell' -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$capture`" -Port $port -Seconds 36000 -OutFile `"$run\serial.log`" -StopFile `"$stop`"" -NoNewWindow -PassThru -RedirectStandardOutput (Join-Path $run 'serial-capture-console.txt') -RedirectStandardError (Join-Path $run 'serial-capture-errors.txt')
$null = $cap_proc.Handle
Start-Sleep -Seconds 3

# 4. Install the JCAlgTest CAP (1.8.5/jc305, or 1.8.6/jc32 for 'pqc'/'pqcperf') on the empty card.
if ($mode -eq 'jcmathlib') {
  $loader = Start-Process -FilePath 'java' -ArgumentList "-cp `"$root\tools\loader;$gp`" LoadCapWithDescriptor `"$reader`" `"$cap`"" -NoNewWindow -Wait -PassThru -RedirectStandardOutput (Join-Path $run 'gp-install.txt') -RedirectStandardError (Join-Path $run 'gp-install.err.txt')
  if ($loader.ExitCode -ne 0) { New-Item -ItemType File -Path $stop | Out-Null; throw "CAP load failed; see $run\gp-install*.txt" }
} elseif ((Invoke-Gp 'gp-install' "--install `"$cap`"") -ne 0) { New-Item -ItemType File -Path $stop | Out-Null; throw "CAP install failed; see $run\gp-install*.txt" }
Invoke-Gp 'gp-list-after-install' '--list' | Out-Null
Get-Content (Join-Path $run 'gp-list-after-install.txt')

# 5. Run the JCAlgTest client. Results and the client log go to $run.
$card = "pico2_maxcrypto_@HEAD_SHORT@_$chip"
Save-Health 'health-before'
$started = Get-Date
if ($mode -eq 'jcmathlib') {
  $client_rc = Invoke-Gp 'jcmathlib-apdu' '--apdu 00A404000B4A434D6174684C69625554 --apdu B024010020D0910DC146EC6027B9318706FD14D6D86199B1324AF4B9B13B4D7D1C09E89DDB00 --debug'
  $ok = Select-String -Path (Join-Path $run 'jcmathlib-apdu.txt') -Pattern '684886E0A3763013DC98C3837E8A6B6C30CCD899257A5CD89DA6BE8E04F44EED 9000' -SimpleMatch -Quiet
  Write-Host "JCMATHLIB result=$(if ($ok) { 'PASS' } else { 'FAIL' })"
} elseif (@('all', 'pqc') -contains $mode) {
  $op = if ($mode -eq 'pqc') { 'ALG_SUPPORT_BASIC' } else { 'ALG_PERFORMANCE_STATIC' }
  $client_proc = Start-Process -FilePath 'java' -ArgumentList "-jar `"$client`" -op $op -cardname $card -fresh -outpath `"$run`"" -WorkingDirectory $run -NoNewWindow -Wait -PassThru
  $client_rc = $client_proc.ExitCode
} else {
  $psi = New-Object System.Diagnostics.ProcessStartInfo
  $psi.FileName = 'java'
  $psi.Arguments = "-jar `"$client`" -cardname $card -outpath `"$run`""
  $psi.WorkingDirectory = $run
  $psi.UseShellExecute = $false
  $psi.RedirectStandardInput = $true
  $client_proc = [System.Diagnostics.Process]::Start($psi)
  $perf_choice = if ($mode -eq 'pqcperf') { '4' } else { '2' }
  foreach ($step in @(@('CHOOSE test you want to run', '2'), @('CHOOSE which type of performance test', $perf_choice))) {
    $wait = (Get-Date).AddSeconds(180)
    while ($true) {
      $log = Get-ChildItem $run -Filter 'ALGTEST_log_*.log' -ErrorAction SilentlyContinue | Select-Object -First 1
      if ($log -and (Select-String -Path $log.FullName -Pattern $step[0] -SimpleMatch -Quiet)) { break }
      if ($client_proc.HasExited -or (Get-Date) -gt $wait) { New-Item -ItemType File -Path $stop | Out-Null; throw "Client prompt '$($step[0])' not seen; see $run" }
      Start-Sleep -Milliseconds 500
    }
    $client_proc.StandardInput.WriteLine($step[1])
    $client_proc.StandardInput.Flush()
  }
  $client_proc.StandardInput.Close()
  $client_proc.WaitForExit()
  $client_rc = $client_proc.ExitCode
}
$finished = Get-Date
Save-Health 'health-after'
Get-Content (Join-Path $run 'health-after.txt')
$uninstall_seconds = ''
if ($mode -eq 'all') {
  # GP-01: timed DELETE right after the long run, then the registry.
  $uninstall_seconds = (Measure-Command { Invoke-Gp 'uninstall' "-d --uninstall `"$cap`"" | Out-Null }).TotalSeconds
  Invoke-Gp 'gp-list-after-uninstall' '--list' | Out-Null
  Write-Host "UNINSTALL seconds=$uninstall_seconds"
  Save-Health 'health-after-uninstall'
}

# 6. Stop the capture, record identity and pack the results for return.
New-Item -ItemType File -Path $stop | Out-Null
$cap_proc.WaitForExit()
Get-Content (Join-Path $run 'serial-capture-console.txt') -Tail 3
@(
  "mode=$mode",
  "client_exit_code=$client_rc",
  "start=$($started.ToString('o'))",
  "end=$($finished.ToString('o'))",
  "chip_id=$chip",
  "serial_port=$port",
  "reader=$reader",
  "windows=$((Get-CimInstance Win32_OperatingSystem).Caption) $([Environment]::OSVersion.Version)",
  "java=$((Get-Command java).Source)",
  "firmware_sha256=$actual",
  "cap_sha256=$((Get-FileHash $cap -Algorithm SHA256).Hash.ToLowerInvariant())",
  "client_jar_sha256=$((Get-FileHash $client -Algorithm SHA256).Hash.ToLowerInvariant())",
  "capture_exit_code=$($cap_proc.ExitCode)",
  "uninstall_seconds=$uninstall_seconds"
) | Set-Content (Join-Path $run 'run-identity.txt')
& java -version 2>&1 | ForEach-Object { "$_" } | Add-Content (Join-Path $run 'run-identity.txt')
Compress-Archive -Path $run -DestinationPath ($run + '.zip') -Force
Write-Host "DONE mode=$mode client_exit_code=$client_rc results=$run.zip"
}
