#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

build_dir="${repo_root}/build/arm"
provenance="${build_dir}/build-provenance.txt"
binary="${build_dir}/pico2_choupi.elf"
[[ -s "${provenance}" ]] || die "ARM build provenance is missing"
grep -qx 'mode=normal' "${provenance}" ||
  die "ARM build must be in normal mode for this check"
[[ -s "${binary}" ]] || die "ARM CHOUPI ELF is missing; build it first"

trace_strings="${build_dir}/no-debug-trace-strings.txt"
strings "${binary}" > "${trace_strings}"
debug_pattern='CHOUPI:(APDU_PROCESS stage=|PERSIST_REF tag_len=|ATHROW |EXCEPTION_(THROW|DISPATCH|CLASS|FRAME|CATCH_REF) |UNCAUGHT_JAVA |VM_CAUGHT_EXCEPTION |VM_PROGRESS |SELECT(_RX|_APDU)? )'
if grep -E "${debug_pattern}" "${trace_strings}"; then
  printf 'TEST:FAIL normal ARM image contains verbose VM or CCID trace strings\n' >&2
  exit 1
fi
grep -q 'OBJECT_DELETION:HEAP_GC' "${trace_strings}" ||
  die "ARM ELF lacks object-deletion event telemetry"
printf 'NO_DEBUG_TRACES:PASS architecture=arm object_deletion_events=present\n'
