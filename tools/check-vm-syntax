#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compiler="${CXX:-c++}"
include_dir="$(mktemp -d)"
trap 'rm -rf "${include_dir}"' EXIT
sources=(
  "${repo_root}/choupi/src/jc_bytecodes/bc_static.cpp"
  "${repo_root}/choupi/src/jc_bytecodes/bc_exceptions.cpp"
  "${repo_root}/choupi/src/jc_handlers/jc_static.cpp"
  "${repo_root}/choupi/src/jc_handlers/jc_class.cpp"
  "${repo_root}/choupi/src/jc_handlers/flashmemory.cpp"
  "${repo_root}/choupi/src/jc_types/jc_array.cpp"
  "${repo_root}/choupi/src/jc_types/jc_instance.cpp"
  "${repo_root}/choupi/src/heap.cpp"
  "${repo_root}/choupi/src/frame.cpp"
  "${repo_root}/choupi/src/interpretor.cpp"
  "${repo_root}/choupi/src/jni.cpp"
  "${repo_root}/choupi/src/context.cpp"
  "${repo_root}/choupi/src/stack.cpp"
)

# The Rust OS submodule that generates ffi.h is not populated in this
# checkout. Variadic declarations let this check parse the VM translation
# units, but intentionally do not validate Rust/C ABI compatibility.
cat >"${include_dir}/ffi.h" <<'EOF'
#pragma once
extern "C" {
int fs_length(...);
int fs_exists(...);
int fs_read(...);
int fs_read_inplace(...);
int fs_write(...);
int fs_erase(...);
int fs_read_1b_at(...);
int fs_read_2b_at(...);
int fs_read_4b_at(...);
int fs_write_1b_at(...);
int fs_write_2b_at(...);
int fs_write_4b_at(...);
void path_applet_field(...);
void path_applet_field16(unsigned char, unsigned char, unsigned short,
                         unsigned char, unsigned char (*)[128],
                         unsigned char *);
void path_cap(...);
void path_package_list(...);
void path_static(...);
}
EOF

if ! command -v "${compiler}" >/dev/null 2>&1; then
  printf 'ERROR: C++ compiler not found: %s\n' "${compiler}" >&2
  exit 1
fi

printf 'Host syntax compiler: %s\n' "$(command -v "${compiler}")"
"${compiler}" -std=c++17 -Wall -Wextra -fsyntax-only \
  -I"${include_dir}" -I"${repo_root}/choupi/src" "${sources[@]}"
printf 'TEST:PASS vm_core_syntax\n'
