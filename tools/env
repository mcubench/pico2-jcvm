#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
toolchain_root="${repo_root}/.local-toolchain/root"
local_home="${repo_root}/.local-toolchain"

if [[ ! -d "${toolchain_root}" ]]; then
  printf 'ERROR: local toolchain is not installed at %s\n' "${toolchain_root}" >&2
  exit 1
fi

export RUSTUP_HOME="${RUSTUP_HOME:-${local_home}/rustup}"
export CARGO_HOME="${CARGO_HOME:-${local_home}/cargo}"
export MAVEN_OPTS="${MAVEN_OPTS:-} -Dmaven.repo.local=${local_home}/m2"
source "${repo_root}/tools/toolchain-path.sh"
toolchain_select_path "${local_home}"
export PATH="${CARGO_HOME}/bin:${PATH}"
export PICO_HOME="${PICO_HOME:-${local_home}}"
# Ignore an ambient PICO_SDK_PATH; the repo pins a TinyUSB-patched SDK.
export PICO_SDK_PATH="${PICO2_SDK_PATH:-${PICO_HOME}/sdk}"

if [[ $# -eq 0 ]]; then
  printf 'Usage: %s <command> [args...]\n' "$0" >&2
  exit 2
fi

exec "$@"
