#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
toolchain_root="${repo_root}/.local-toolchain/root"
local_home="${repo_root}/.local-toolchain"

if [[ ! -d "${toolchain_root}" ]]; then
  printf 'ERROR: local toolchain is not installed at %s\n' "${toolchain_root}" >&2
  exit 1
fi

export RUSTUP_HOME="${RUSTUP_HOME:-${local_home}/rustup}"
export CARGO_HOME="${CARGO_HOME:-${local_home}/cargo}"
export PATH="${CARGO_HOME}/bin:${toolchain_root}/usr/bin:${toolchain_root}/pioasm:${toolchain_root}/picotool:${local_home}/toolchain/riscv/bin:${PATH}"
export LD_LIBRARY_PATH="${toolchain_root}/usr/lib/x86_64-linux-gnu:${local_home}/toolchain/riscv/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export PICO_HOME="${PICO_HOME:-${local_home}}"
export PICO_SDK_PATH="${PICO_SDK_PATH:-${PICO_HOME}/sdk}"

if [[ $# -eq 0 ]]; then
  printf 'Usage: %s <command> [args...]\n' "$0" >&2
  exit 2
fi

exec "$@"
