#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

build_dir="${repo_root}/build/choupi-pc"
java8_home="${JAVA8_HOME:-${repo_root}/.local-toolchain/java8}"
jcvm_debug="${CHOUPI_JCVM_DEBUG:-OFF}"
[[ -x "${java8_home}/bin/javac" ]] || \
  die "Java 8 javac not found; set JAVA8_HOME to a JDK 8 installation"

"${repo_root}/tools/env" cmake \
  -S "${repo_root}/choupi" \
  -B "${build_dir}" \
  -DCHOUPI_TARGET_PC=ON \
  -DCHOUPI_TARGET_STM32=OFF \
  -DCHOUPI_OS_DEBUG=OFF \
  -DCHOUPI_JCVM_DEBUG="${jcvm_debug}" \
  -DCHOUPI_JAVA8_HOME="${java8_home}"

"${repo_root}/tools/env" cmake --build "${build_dir}" --target rommask choupi -j2

rom_image="${build_dir}/flash"
generated_header="${build_dir}/jni.hpp"
[[ -s "${rom_image}" ]] || die "ROM-mask generation did not produce ${rom_image}"
[[ -s "${generated_header}" ]] || die "ROM-mask generation did not produce ${generated_header}"
(
  cd "${build_dir}"
  sha256sum flash jni.hpp > generation.sha256
  find "${repo_root}/choupi/javacard-sdk/javacard-api/src" \
    -type f -name '*.java' -print0 | sort -z | xargs -0 sha256sum | \
    sha256sum | awk '{print $1 "  javacard-api-sources"}' > api-sources.sha256
  sha256sum api-sources.sha256 >> generation.sha256
)
printf 'ROMMASK:PASS image=%s header=%s manifest=%s\n' \
  "${rom_image#${repo_root}/}" "${generated_header#${repo_root}/}" \
  "${build_dir#${repo_root}/}/generation.sha256"
