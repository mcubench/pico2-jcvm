#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${repo_root}/build/tests/rmi-cap-metadata"

"${repo_root}/tools/env" cmake -S "${repo_root}/tools/tests/rmi_cap_metadata" \
  -B "${build_dir}" -DCMAKE_BUILD_TYPE=Release
"${repo_root}/tools/env" cmake --build "${build_dir}" \
  --target rmi_cap_metadata_test --parallel 2
"${build_dir}/rmi_cap_metadata_test"
