#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"
require_host_usb_access

[[ $# -eq 2 ]] || die "usage: PICO2_HOST_USB_ACCESS=1 ./tools/test-longop01-rsa1984-physical <chip-id> '<exact PC/SC reader name>'"
chip_id="$1"
reader_name="$2"
[[ "$chip_id" =~ ^[A-Fa-f0-9]{8,32}$ ]] || die "chip ID must be hexadecimal"
[[ "$reader_name" == *"$chip_id"* ]] || die "reader name does not contain the selected chip ID"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
result_dir="${repo_root}/artifacts/results/longop01-rsa1984-physical-${timestamp}/${chip_id}"
mkdir -p "$result_dir"
client_log="${result_dir}/probe.log"
serial_log="${result_dir}/serial.log"
build_dir="${repo_root}/build/longop01-rsa1984-probe"
mkdir -p "$build_dir"

"${repo_root}/tools/env" javac -d "$build_dir" \
  "${repo_root}/tests/hardware/JCAlgTestRsa1984PhysicalProbe.java"
printf 'PHYSICAL:IDENTITY chip_id=%s reader=%s\n' "$chip_id" "$reader_name" | tee "$client_log"
printf 'FIRMWARE_SHA256 %s\n' \
  "$(sha256sum "${repo_root}/build/arm/pico2_choupi.uf2" | awk '{print $1}')" | tee -a "$client_log"
printf 'JCALGTEST_CAP_VERSION 1.8.4_jc305 SHA256 %s\n' \
  "$(sha256sum "${repo_root}/tests/fixtures/external/jcalgtest/1.8.4/AlgTest_v1.8.4_jc305.cap" | awk '{print $1}')" | tee -a "$client_log"
printf 'APDU_SEQUENCE_SOURCE_JAR_SHA256 b6a753be280a225efc1b237fd53319c01946af15b4f2ae2e57adaad8e3eacec3\n' | tee -a "$client_log"

PICO2_HOST_USB_ACCESS=1 "${repo_root}/tools/monitor" \
  --serial "$chip_id" --seconds 200 >"$serial_log" 2>&1 &
monitor_pid=$!
set +e
timeout --signal=TERM --kill-after=5s 180s \
  "${repo_root}/tools/env" java -cp "$build_dir" \
  JCAlgTestRsa1984PhysicalProbe "$reader_name" >>"$client_log" 2>&1
client_status=$?
wait "$monitor_pid"
monitor_status=$?
set -e
cat "$client_log"
cat "$serial_log"
(( client_status == 0 )) || die "physical APDU probe failed with status ${client_status}; see ${client_log}"
(( monitor_status == 0 )) || die "finite serial monitor failed with status ${monitor_status}; see ${serial_log}"

python3 - "$serial_log" <<'PY'
import re
import sys
from pathlib import Path

lines = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace").splitlines()
measure_found = False
measure_responses = 0
memory_samples = []
active_sample = None
sample_extensions = {}
for line in lines:
    if "CHOUPI:USB_PROGRESS " in line:
        fields = dict(re.findall(r"([a-z_]+)=([0-9]+)", line))
        if "extensions" in fields and "completed" in fields:
            if active_sample is not None:
                sample_extensions[active_sample] = (
                    int(fields["extensions"]), int(fields["completed"]))
                active_sample = None
    if "CHOUPI:CCID_RESPONSE apdu=B043000016" in line and "sw=9000" in line:
        measure_found = True
        measure_responses += 1
    if "CHOUPI:RSA_MEMORY apdu=B043 " in line:
        fields = dict(re.findall(r"([a-z_]+)=([A-Fa-f0-9-]+)", line))
        required = {"profile", "start_free", "min_free", "end_free", "delta", "samples", "elapsed_us"}
        if required.issubset(fields):
            memory_samples.append({key: int(fields[key], 16) if key == "profile" else int(fields[key]) for key in required})
            active_sample = len(memory_samples) - 1
if not measure_found:
    raise SystemExit("PHYSICAL:FAIL finite serial log did not contain successful B043 response")
if measure_responses < 6:
    raise SystemExit("PHYSICAL:FAIL expected RSA-1984, RSA-1536 and RSA-2048 B043 responses")
if len(memory_samples) < 3:
    raise SystemExit("PHYSICAL:FAIL all three RSA B043 target allocator samples are required")
expected_profiles = (0x0a, 0x0d, 0x0a)
for sample_index, expected_profile in enumerate(expected_profiles):
    memory_sample = memory_samples[sample_index]
    if memory_sample["profile"] != expected_profile:
        raise SystemExit(f"PHYSICAL:FAIL target allocator sample {sample_index + 1} profile={expected_profile:02X}, got={memory_sample['profile']:02X}")
    if (memory_sample["samples"] < 2 or memory_sample["elapsed_us"] <= 0 or
            memory_sample["min_free"] > memory_sample["start_free"] or
            memory_sample["min_free"] > memory_sample["end_free"]):
        raise SystemExit(f"PHYSICAL:FAIL B043 allocator sample inconsistent profile={expected_profile:02X}")
    print("PHYSICAL:MEMORY " + " ".join(
        f"{key}={memory_sample[key]:02X}" if key == "profile" else f"{key}={memory_sample[key]}"
        for key in sorted(memory_sample)))
    extensions = sample_extensions.get(sample_index)
    if sample_index in (0, 2):
        if extensions is None:
            raise SystemExit(f"PHYSICAL:FAIL completed CCID extensions missing B043 sample={sample_index + 1}")
        print(f"PHYSICAL:TELEMETRY B043 sample={sample_index + 1} profile={expected_profile:02X} extensions={extensions[0]} completed={extensions[1]}")
    elif extensions is None:
        print(f"PHYSICAL:TELEMETRY B043 sample={sample_index + 1} profile={expected_profile:02X} extensions=0 control=completed-without-extension")
    else:
        print(f"PHYSICAL:TELEMETRY B043 sample={sample_index + 1} profile={expected_profile:02X} extensions={extensions[0]} completed={extensions[1]}")
PY
for marker in \
  'TEST:PASS RSA1984_PRIVATE_PKCS1_X50' \
  'TEST:PASS RSA1536_PRIVATE_ISO14888_X50' \
  'TEST:PASS RSA2048_PRIVATE_PKCS1_X50' \
  'TEST:PASS RSA2048_SHA_PKCS1_SIGNATURE_SIGN'; do
  grep -Fq "$marker" "$client_log" || die "physical probe did not report $marker"
done
printf 'PHYSICAL:PASS result_dir=%s\n' "${result_dir#${repo_root}/}"
