#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

[[ $# -ge 1 ]] || die "usage: ./tools/cycle arm|riscv|choupi [--profile PROFILE] [--serial SERIAL | --chipid CHIPID | --usb-path PATH]"
arch="$1"
[[ "$arch" == arm || "$arch" == riscv || "$arch" == choupi ]] || die "choose arm, riscv, or choupi"
shift
serial=""
chipid=""
usb_path=""
support_profile=current
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ $# -ge 2 ]] || die "--profile requires a profile name"
      support_profile="$2"
      shift 2
      ;;
    --serial)
      [[ $# -ge 2 && -z "$serial" && "$2" =~ ^[A-Fa-f0-9]{8,32}$ ]] || die "--serial requires an 8..32 character hexadecimal Pico serial"
      serial="$2"
      shift 2
      ;;
    --chipid)
      [[ $# -ge 2 && -z "$chipid" && "$2" =~ ^[A-Fa-f0-9]{16}$ ]] || die "--chipid requires a 16-character hexadecimal RP2350 chip ID"
      chipid="$2"
      shift 2
      ;;
    --usb-path)
      [[ $# -ge 2 && -z "$usb_path" && "$2" =~ ^[0-9]+-[0-9]+([.][0-9]+)*$ ]] || die "--usb-path requires a USB topology path such as 1-3 or 1-3.2"
      usb_path="$2"
      shift 2
      ;;
    *) die "usage: ./tools/cycle arm|riscv|choupi [--profile PROFILE] [--serial SERIAL | --chipid CHIPID | --usb-path PATH]" ;;
  esac
done
selector_count=0
[[ -z "$serial" ]] || ((selector_count += 1))
[[ -z "$chipid" ]] || ((selector_count += 1))
[[ -z "$usb_path" ]] || ((selector_count += 1))
((selector_count <= 1)) || die "choose only one of --serial, --chipid, or --usb-path"
require_host_usb_access
"${repo_root}/tools/build" arm --profile "${support_profile}"
"${repo_root}/tools/build" riscv --profile "${support_profile}"
if [[ "${arch}" == choupi ]]; then
  image="${repo_root}/build/arm/pico2_choupi.uf2"
else
  image="${repo_root}/build/${arch}/pico2_jcvm_smoke.uf2"
fi
log_dir="${repo_root}/artifacts/logs"
mkdir -p "$log_dir"
log_file="${log_dir}/cycle-${arch}-$(date -u +%Y%m%dT%H%M%SZ).log"
printf 'CYCLE:FLASH arch=%s profile=%s image=%s\n' "$arch" "$support_profile" "${image#${repo_root}/}" | tee "$log_file"
flash_args=()
monitor_args=()
if [[ -n "$serial" ]]; then
  flash_args=(--serial "$serial")
  monitor_args=(--serial "$serial")
elif [[ -n "$chipid" ]]; then
  flash_args=(--chipid "$chipid")
  monitor_args=(--serial "$chipid")
elif [[ -n "$usb_path" ]]; then
  flash_args=(--usb-path "$usb_path")
  monitor_args=(--usb-path "$usb_path")
fi
"${repo_root}/tools/flash" "${flash_args[@]}" "$image" 2>&1 | tee -a "$log_file"
capture_seconds=8
if [[ "${arch}" == choupi ]]; then
  capture_seconds=18
fi
set +e
"${repo_root}/tools/monitor" "${monitor_args[@]}" --seconds "${capture_seconds}" 2>&1 | tee -a "$log_file"
monitor_status=${PIPESTATUS[0]}
set -e
(( monitor_status == 0 )) || die "serial monitor failed with status ${monitor_status}; log: ${log_file}"
normalized_log="$(tr -d '\r' < "$log_file")"
if [[ "${arch}" == choupi ]]; then
  # USB CDC may enumerate after the one-time BOOT banner, so accept the
  # runtime's repeated known-answer result as the health signal.
  if ! grep -q '^TEST:PASS choupi_runtime$' <<<"${normalized_log}" || \
      ! grep -q '^TEST:SUMMARY pass=1 fail=0$' <<<"${normalized_log}" || \
      grep -Eq '^TEST:FAIL|^FAULT' <<<"${normalized_log}"; then
    die "CHOUPI runtime output did not pass; inspect ${log_file}"
  fi
elif ! grep -q '^TEST:PASS random_stream_varies$' <<<"${normalized_log}" || \
    grep -Eq '^TEST:FAIL|^FAULT' <<<"${normalized_log}"; then
  die "hardware test output did not pass; inspect ${log_file}"
fi
printf 'CYCLE:PASS arch=%s log=%s\n' "$arch" "${log_file#${repo_root}/}" | tee -a "$log_file"
