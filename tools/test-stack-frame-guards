#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${repo_root}/build/tests/unit/stack-frame-guards"

"${repo_root}/tools/env" cmake -S "${repo_root}/tests/unit/stack_frame_guards" \
  -B "${build_dir}" -DCMAKE_BUILD_TYPE=Release
"${repo_root}/tools/env" cmake --build "${build_dir}" \
  --target stack_frame_guards_test --parallel 2
ASAN_OPTIONS="${ASAN_OPTIONS:+${ASAN_OPTIONS}:}detect_leaks=0" \
  "${build_dir}/stack_frame_guards_test"
