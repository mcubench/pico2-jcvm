#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log_dir="${repo_root}/artifacts/logs"
mkdir -p "${log_dir}"

CHOUPI_JCVM_DEBUG=ON "${repo_root}/tools/build-pc" \
  > "${log_dir}/build-pc-dup-x-${timestamp}.log" 2>&1
DUP_X_MATRIX=1 DUP_X_INVALID_RUNTIME=1 DUP_X_INVALID_MATRIX=1 \
  "${repo_root}/tools/build-dup-x-fixture"

PICO2_HEAP_GC=1 "${repo_root}/tools/test-pc-vpcd-applet" \
  --passes 1 \
  --cap-code "${repo_root}/build/dup-x-fixture/dup-x-fixture-load-code.bin" \
  --applet-aid A0000001510000006001 \
  --package-id 63 \
  --apdu 00010000 \
  --apdu 00020000 \
  --apdu 00030000 \
  --apdu 00020000 \
  --apdu 00040000 \
  --apdu 00020000 \
  --apdu 00050000 \
  --apdu 00020000 \
  --apdu 00060000 \
  --apdu 00020000 \
  --log "${log_dir}/dup-x-vpcd-${timestamp}.log" \
  > "${log_dir}/dup-x-host-${timestamp}.log" 2>&1

rg -q 'TEST:SUMMARY pass=12 fail=0' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: VPCD recovery run did not complete all ten custom APDUs\n' >&2
  exit 1
}
rg -q 'custom APDU 1 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: caught invalid dup_x APDU did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 2 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: APDU following the caught invalid dup_x did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 3 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: invalid-operand matrix APDU did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 4 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: APDU following the invalid-operand matrix did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 5 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: typed reference dup_x APDU did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 6 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: APDU following the typed reference case did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 7 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: complete-int dup_x APDU did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 8 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: APDU following the complete-int case did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 9 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: mixed short/int dup_x APDU did not return 9000\n' >&2
  exit 1
}
rg -q 'custom APDU 10 response=9000' \
  "${log_dir}/dup-x-host-${timestamp}.log" || {
  printf 'ERROR: APDU following the mixed short/int case did not return 9000\n' >&2
  exit 1
}

for m in 1 2 3 4; do
  for n in 0 "$(seq "${m}" "$((m + 4))")"; do
    for value in ${n}; do
      operand=$(( (m << 4) | value ))
      printf -v expected 'DUP_X 0x%02X' "${operand}"
      rg -q "${expected}" "${log_dir}/dup-x-vpcd-${timestamp}.log" || {
        printf 'ERROR: legal dup_x operand %s was not observed in the interpreter log\n' "${expected}" >&2
        exit 1
      }
    done
  done
done
python3 - "${log_dir}/dup-x-vpcd-${timestamp}.log" <<'PY'
import re
import sys
from pathlib import Path

log = Path(sys.argv[1]).read_text(errors="replace")
legal = {
    (m << 4) | n
    for m in range(1, 5)
    for n in (0, *range(m, m + 5))
}
invalid = set(range(256)) - legal
observed = {
    int(value, 16) & 0xFF
    for value in re.findall(r"DUP_X 0x([0-9A-F]+)", log)
}
missing = sorted(invalid - observed)
if missing:
    raise SystemExit(
        f"invalid dup_x interpreter matrix missing {len(missing)} operands: "
        + ", ".join(f"0x{value:02X}" for value in missing[:12])
    )
print("DUP_X_INVALID_MATRIX_LOG:PASS operands=232")
PY
rg -q 'VPCD:APPLET_INSTALLED package-id=56' \
  "${log_dir}/dup-x-vpcd-${timestamp}.log" || {
  printf 'ERROR: dup_x fixture applet installation was not observed\n' >&2
  exit 1
}

DUP_X_OPERAND=23 "${repo_root}/tools/build-dup-x-fixture"
invalid_log="${log_dir}/dup-x-invalid-vpcd-${timestamp}.log"
invalid_host_log="${log_dir}/dup-x-invalid-host-${timestamp}.log"
if PICO2_HEAP_GC=1 "${repo_root}/tools/test-pc-vpcd-applet" \
  --passes 1 \
  --cap-code "${repo_root}/build/dup-x-fixture/dup-x-fixture-load-code.bin" \
  --applet-aid A0000001510000006001 \
  --package-id 63 \
  --select-only \
  --log "${invalid_log}" > "${invalid_host_log}" 2>&1; then
  printf 'ERROR: invalid dup_x operand unexpectedly installed\n' >&2
  exit 1
fi
rg -q 'DUP_X 0x17' "${invalid_log}" || {
  printf 'ERROR: invalid dup_x operand did not reach interpreter dispatch\n' >&2
  exit 1
}
rg -q 'ERROR: PC applet INSTALL failed .*vm=6F00' "${invalid_log}" || {
  printf 'ERROR: invalid dup_x operand did not fail applet install safely\n' >&2
  exit 1
}
if rg -q 'VPCD:APPLET_INSTALLED' "${invalid_log}"; then
  printf 'ERROR: invalid dup_x CAP was recorded as installed\n' >&2
  exit 1
fi
"${repo_root}/tools/build-dup-x-fixture" > /dev/null
printf 'DUP_X_INVALID_VPCD:PASS operand=0x17 rejected with vm=6F00\n'
printf 'DUP_X_MATRIX_VPCD:PASS legal_operands=24\n'
printf 'DUP_X_INVALID_MATRIX_VPCD:PASS invalid_operands=232\n'
printf 'DUP_X_RECOVERY_VPCD:PASS caught_operand=0x17 matrices_apdu=9000 following_apdu=9000\n'
printf 'DUP_X_TYPED_REFERENCE_VPCD:PASS operand=0x12 identity_and_short_result=valid\n'
printf 'DUP_X_TYPED_INT_VPCD:PASS operand=0x24 complete_int_pair_result=0x12345678\n'
printf 'DUP_X_TYPED_MIXED_VPCD:PASS operand=0x23 short_plus_complete_int_pair=valid\n'
printf 'DUP_X_VPCD:PASS log=%s\n' \
  "${log_dir}/dup-x-vpcd-${timestamp}.log"
printf 'DUP_X_HOST:PASS log=%s\n' \
  "${log_dir}/dup-x-host-${timestamp}.log"
