#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
log_dir="${repo_root}/artifacts/logs"
mkdir -p "${log_dir}"

CHOUPI_JCVM_DEBUG=ON "${repo_root}/tools/build-pc" \
  > "${log_dir}/build-pc-dup-x-${timestamp}.log" 2>&1
DUP_X_MATRIX=1 "${repo_root}/tools/build-dup-x-fixture"

PICO2_HEAP_GC=1 "${repo_root}/tools/test-pc-vpcd-applet" \
  --passes 1 \
  --cap-code "${repo_root}/build/dup-x-fixture/dup-x-fixture-load-code.bin" \
  --applet-aid A0000001510000006001 \
  --package-id 63 \
  --select-only \
  --log "${log_dir}/dup-x-vpcd-${timestamp}.log"

for m in 1 2 3 4; do
  for n in 0 "$(seq "${m}" "$((m + 4))")"; do
    for value in ${n}; do
      operand=$(( (m << 4) | value ))
      printf -v expected 'DUP_X 0x%02X' "${operand}"
      rg -q "${expected}" "${log_dir}/dup-x-vpcd-${timestamp}.log" || {
        printf 'ERROR: legal dup_x operand %s was not observed in the interpreter log\n' "${expected}" >&2
        exit 1
      }
    done
  done
done
rg -q 'VPCD:APPLET_INSTALLED package-id=56' \
  "${log_dir}/dup-x-vpcd-${timestamp}.log" || {
  printf 'ERROR: dup_x fixture applet installation was not observed\n' >&2
  exit 1
}

DUP_X_OPERAND=23 "${repo_root}/tools/build-dup-x-fixture"
invalid_log="${log_dir}/dup-x-invalid-vpcd-${timestamp}.log"
invalid_host_log="${log_dir}/dup-x-invalid-host-${timestamp}.log"
if PICO2_HEAP_GC=1 "${repo_root}/tools/test-pc-vpcd-applet" \
  --passes 1 \
  --cap-code "${repo_root}/build/dup-x-fixture/dup-x-fixture-load-code.bin" \
  --applet-aid A0000001510000006001 \
  --package-id 63 \
  --select-only \
  --log "${invalid_log}" > "${invalid_host_log}" 2>&1; then
  printf 'ERROR: invalid dup_x operand unexpectedly installed\n' >&2
  exit 1
fi
rg -q 'DUP_X 0x17' "${invalid_log}" || {
  printf 'ERROR: invalid dup_x operand did not reach interpreter dispatch\n' >&2
  exit 1
}
rg -q 'ERROR: PC applet INSTALL failed .*vm=6F00' "${invalid_log}" || {
  printf 'ERROR: invalid dup_x operand did not fail applet install safely\n' >&2
  exit 1
}
if rg -q 'VPCD:APPLET_INSTALLED' "${invalid_log}"; then
  printf 'ERROR: invalid dup_x CAP was recorded as installed\n' >&2
  exit 1
fi
"${repo_root}/tools/build-dup-x-fixture" > /dev/null
printf 'DUP_X_INVALID_VPCD:PASS operand=0x17 rejected with vm=6F00\n'
printf 'DUP_X_MATRIX_VPCD:PASS legal_operands=24\n'
printf 'DUP_X_VPCD:PASS log=%s\n' \
  "${log_dir}/dup-x-vpcd-${timestamp}.log"
