#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${repo_root}/build/tests/unit/persistent-transaction"

"${repo_root}/tools/env" cmake -S "${repo_root}/tests/unit/persistent_transaction" \
  -B "${build_dir}" -DCMAKE_BUILD_TYPE=Release
"${repo_root}/tools/env" cmake --build "${build_dir}" \
  --target persistent_transaction_test --parallel 2
"${build_dir}/persistent_transaction_test"
