#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_root="${repo_root}/tests/fixtures/local/cap_import_policy"
build_dir="${repo_root}/build/cap-import-policy-fixture"
kit="$("${repo_root}/tools/fixture-path" toolchain.jc305)"
api_classes="${repo_root}/build/choupi-pc/javacard-api"
nativeimpl_exp="${api_classes}/fr/gouv/ssi/nativeimpl/javacard/nativeimpl.exp"
java8_home="${JAVA8_HOME:-${repo_root}/.local-toolchain/java8}"
package_aid='0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x31'
applet_aid='0xA0:0x00:0x00:0x01:0x51:0x00:0x00:0x31:0x01'

[[ -x "${java8_home}/bin/javac" ]] || {
  printf 'ERROR: Java 8 compiler not found: %s\n' "${java8_home}" >&2
  exit 1
}
[[ -s "${nativeimpl_exp}" ]] || {
  printf 'ERROR: generated native bridge export file is missing: %s\n' \
    "${nativeimpl_exp}" >&2
  exit 1
}
rm -rf "${build_dir}"
mkdir -p "${build_dir}/classes" "${build_dir}/cap"
"${repo_root}/tools/env" "${java8_home}/bin/javac" \
  -source 1.7 -target 1.7 -Xlint:-options \
  -classpath "${kit}/lib/api_classic.jar:${api_classes}" \
  -d "${build_dir}/classes" "${source_root}"/*.java
"${repo_root}/tools/env" java "-Duser.home=${build_dir}" "-Djc.home=${kit}" \
  -cp "${kit}/lib/tools.jar" com.sun.javacard.converter.Main -nobanner \
  -classdir "${build_dir}/classes" \
  -exportpath "${kit}/api_export_files:${api_classes}" \
  -d "${build_dir}/cap" -out CAP \
  -applet "${applet_aid}" capimportpolicy.BridgeImportApplet \
  capimportpolicy "${package_aid}" 1.0
"${repo_root}/tools/env" java "-Duser.home=${build_dir}" "-Djc.home=${kit}" \
  -cp "${kit}/lib/tools.jar" com.sun.javacard.converter.Main -nobanner \
  -classdir "${build_dir}/classes" \
  -exportpath "${kit}/api_export_files:${api_classes}" \
  -d "${build_dir}/jca" -out JCA \
  -applet "${applet_aid}" capimportpolicy.BridgeImportApplet \
  capimportpolicy "${package_aid}" 1.0

cap_file="${build_dir}/cap/capimportpolicy/javacard/capimportpolicy.cap"
jca_file="${build_dir}/jca/capimportpolicy/javacard/capimportpolicy.jca"
[[ -s "${cap_file}" ]] || {
  printf 'ERROR: converted CAP fixture missing: %s\n' "${cap_file}" >&2
  exit 1
}
rg -q '0x60:0x0:0x1.*fr/gouv/ssi/nativeimpl' "${jca_file}" || {
  printf 'ERROR: hostile fixture does not import the native bridge AID\n' >&2
  exit 1
}
rg -q 'staticMethodRef .*fr/gouv/ssi/nativeimpl/NativeImplementation\.getAID' \
  "${jca_file}" || {
  printf 'ERROR: hostile fixture has no external StaticMethodref to bridge\n' >&2
  exit 1
}
printf 'CAP_IMPORT_POLICY_FIXTURE:PASS cap=%s\n' "${cap_file}"
